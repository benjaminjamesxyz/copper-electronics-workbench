[
  {
    "id": "passives.mlcc_logarithmic_aging",
    "title": "Ferroelectric capacitor logarithmic aging",
    "category": "Nonideal passive components",
    "level": "basic",
    "description": "Estimate capacitance loss from a measured one-hour post-deaging value and a calibrated percent-per-decade aging rate.",
    "formula": "d = log10(t/3600 s); loss = A d/100; C(t) = C_1h (1-loss)",
    "assumptions": [
      "Class II/III ferroelectric ceramic with an approximately constant logarithmic aging rate over the supplied interval.",
      "Time is seconds since the last heating above the material Curie temperature; reference capacitance is measured at exactly one hour.",
      "No subsequent deaging, temperature change or DC-bias change. Aging rate is percent of the one-hour reference per decade, not compounded percent of the preceding decade.",
      "Use part-specific characterized aging data. This is not a lifetime or reliability prediction."
    ],
    "references": [
      {
        "title": "KYOCERA AVX / American Technical Ceramics, Dielectric Aging Phenomena, Calculating Aging Rate",
        "url": "https://rfs.kyocera-avx.com/userFiles/uploads/pdfs/dielectric_aging.pdf"
      }
    ],
    "inputs": [
      {
        "key": "capacitance_one_hour",
        "label": "Capacitance one hour after deaging",
        "unit": "F",
        "default": 1e-05,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "aging_percent_decade",
        "label": "Aging rate per time decade",
        "unit": "%/decade",
        "default": 2,
        "min": 0
      },
      {
        "key": "age",
        "label": "Time since last deaging",
        "unit": "s",
        "default": 36000000,
        "min": 3600
      }
    ],
    "outputs": [
      {
        "key": "elapsed_decades",
        "label": "Decades after one-hour reference",
        "unit": "decade",
        "expression": "log1p((age-3600)/3600)/ln(10)"
      },
      {
        "key": "fractional_loss",
        "label": "Fractional capacitance loss",
        "unit": "1",
        "expression": "aging_percent_decade/100*elapsed_decades"
      },
      {
        "key": "aged_capacitance",
        "label": "Aged capacitance",
        "unit": "F",
        "expression": "capacitance_one_hour*(1-fractional_loss)"
      }
    ],
    "constraints": [
      {
        "left": "aging_percent_decade/100*(log1p((age-3600)/3600)/ln(10))",
        "op": "<",
        "right": "1",
        "message": "The logarithmic fit must retain positive capacitance."
      }
    ],
    "example": {
      "inputs": {
        "capacitance_one_hour": 1e-05,
        "aging_percent_decade": 2,
        "age": 36000000
      },
      "expected": {
        "elapsed_decades": 4,
        "fractional_loss": 0.08,
        "aged_capacitance": 9.2e-06
      },
      "relative_tolerance": 1e-06
    }
  },
  {
    "id": "passives.dielectric_absorption_recovery",
    "title": "Capacitor dielectric-memory voltage recovery",
    "category": "Nonideal passive components",
    "level": "expert",
    "description": "Predict reappearing terminal voltage after finite charging, ideal shorting and open-circuit recovery of a one-branch dielectric-absorption model.",
    "formula": "V_a0 = V_ch [1-exp(-t_ch/(R_a C_a))] exp(-t_short/(R_a C_a)); tau = R_a C_a C_m/(C_a+C_m); V_inf = V_a0 C_a/(C_a+C_m); V_rec = V_inf [1-exp(-t_rec/tau)]",
    "assumptions": [
      "Main capacitance C_m is in parallel with a SERIES R_a-C_a polarization branch. Both capacitors start uncharged.",
      "An ideal voltage source clamps the terminals during charge; an ideal short clamps them during discharge; both are disconnected during recovery.",
      "No terminal leakage, measurement loading, ESR, ESL or additional absorption branches. Parameters must be fitted to the relevant time and temperature range.",
      "This is a reduced dielectric-polarization memory model, not the full IEC dielectric-absorption test or a safety guarantee that a discharged capacitor remains safe."
    ],
    "references": [
      {
        "title": "Texas Instruments SBOA597, section 4.5 Dielectric Absorption and Relaxation, Figure 4-15",
        "url": "https://www.ti.com/lit/pdf/sboa597"
      }
    ],
    "inputs": [
      {
        "key": "main_capacitance",
        "label": "Fast terminal capacitance",
        "unit": "F",
        "default": 1e-06,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "absorption_capacitance",
        "label": "Polarization branch capacitance",
        "unit": "F",
        "default": 1e-08,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "absorption_resistance",
        "label": "Polarization relaxation resistance",
        "unit": "ohm",
        "default": 1000000000,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "charge_voltage",
        "label": "Applied charge voltage",
        "unit": "V",
        "default": 10
      },
      {
        "key": "charge_time",
        "label": "Voltage-clamped charging time",
        "unit": "s",
        "default": 20,
        "min": 0
      },
      {
        "key": "short_time",
        "label": "Terminal shorting time",
        "unit": "s",
        "default": 1,
        "min": 0
      },
      {
        "key": "recovery_time",
        "label": "Time after removing short",
        "unit": "s",
        "default": 10,
        "min": 0
      }
    ],
    "outputs": [
      {
        "key": "memory_voltage",
        "label": "Hidden polarization voltage after short",
        "unit": "V",
        "expression": "charge_voltage*(-expm1(-charge_time/absorption_resistance/absorption_capacitance))*exp(-short_time/absorption_resistance/absorption_capacitance)"
      },
      {
        "key": "recovery_time_constant",
        "label": "Open-terminal recovery time constant",
        "unit": "s",
        "expression": "absorption_resistance*absorption_capacitance/(1+absorption_capacitance/main_capacitance)"
      },
      {
        "key": "final_recovery_voltage",
        "label": "Asymptotic recovered terminal voltage",
        "unit": "V",
        "expression": "memory_voltage/(1+main_capacitance/absorption_capacitance)"
      },
      {
        "key": "recovered_voltage",
        "label": "Recovered terminal voltage at observation",
        "unit": "V",
        "expression": "final_recovery_voltage*(-expm1(-recovery_time/recovery_time_constant))"
      }
    ],
    "constraints": [],
    "example": {
      "inputs": {
        "main_capacitance": 1e-06,
        "absorption_capacitance": 1e-08,
        "absorption_resistance": 1000000000,
        "charge_voltage": 10,
        "charge_time": 20,
        "short_time": 1,
        "recovery_time": 10
      },
      "expected": {
        "memory_voltage": 7.823809897829776,
        "recovery_time_constant": 9.900990099009901,
        "final_recovery_voltage": 0.07746346433494829,
        "recovered_voltage": 0.04924980040079833
      },
      "relative_tolerance": 1e-06
    }
  }
]
