[
  {
    "id": "thermal.resistor_power_derating",
    "title": "Linear resistor power derating",
    "category": "Thermal and reliability design",
    "level": "basic",
    "description": "Interpolate a specified flat-then-linear resistor rating curve and compare actual dissipation with the resulting permissible power.",
    "formula": "f=min(1,max(0,(T_zero-Ta)/(T_zero-T_rated))); P_allowed=P_rated f; margin=P_allowed-P_actual",
    "assumptions": [
      "The part datasheet specifies full rated power through T_rated followed by a straight line to zero power at T_zero; parameters are not universal resistor values.",
      "Ta means the datasheet's specified rating reference temperature, ambient for this model. Do not substitute solder-pad temperature unless the curve is defined that way.",
      "Actual dissipation is supplied independently; only continuous power is compared. Pulse overload, limiting voltage, PCB temperature and mounting restrictions still apply.",
      "No power uprating below the full-rating breakpoint. Temperatures above T_zero are rejected rather than described as safe at zero dissipation. Negative power margin signals overload."
    ],
    "references": [
      {
        "title": "Vishay Sfernice 53048: existing derating curves and mounting limitations, sections D-E",
        "url": "https://www.vishay.com/docs/53048/pprachp.pdf"
      }
    ],
    "inputs": [
      {
        "key": "rated_power",
        "label": "Full continuous power rating",
        "unit": "W",
        "default": 0.25,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "rated_temperature",
        "label": "Full-rating temperature breakpoint",
        "unit": "K",
        "default": 343.15,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "zero_power_temperature",
        "label": "Zero-power temperature endpoint",
        "unit": "K",
        "default": 428.15,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "ambient_temperature",
        "label": "Datasheet ambient reference temperature",
        "unit": "K",
        "default": 373.15,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "actual_power",
        "label": "Actual continuous resistor dissipation",
        "unit": "W",
        "default": 0.12,
        "min": 0
      }
    ],
    "outputs": [
      {
        "key": "rating_fraction",
        "label": "Available full-rating fraction",
        "unit": "1",
        "expression": "min(1,max(0,(zero_power_temperature-ambient_temperature)/(zero_power_temperature-rated_temperature)))"
      },
      {
        "key": "allowed_power",
        "label": "Derated continuous power allowance",
        "unit": "W",
        "expression": "rated_power*rating_fraction"
      },
      {
        "key": "power_margin",
        "label": "Power allowance minus actual dissipation",
        "unit": "W",
        "expression": "allowed_power-actual_power"
      }
    ],
    "constraints": [
      {
        "left": "zero_power_temperature",
        "op": ">",
        "right": "rated_temperature",
        "message": "The zero-power endpoint must exceed the full-rating breakpoint."
      },
      {
        "left": "ambient_temperature",
        "op": "<=",
        "right": "zero_power_temperature",
        "message": "Ambient is above the rating curve's maximum temperature endpoint."
      }
    ],
    "example": {
      "inputs": {
        "rated_power": 0.25,
        "rated_temperature": 343.15,
        "zero_power_temperature": 428.15,
        "ambient_temperature": 373.15,
        "actual_power": 0.12
      },
      "expected": {
        "rating_fraction": 0.6470588235294118,
        "allowed_power": 0.16176470588235295,
        "power_margin": 0.04176470588235294
      },
      "relative_tolerance": 1e-06
    }
  },
  {
    "id": "thermal.junction_feedback_equilibrium",
    "title": "Junction temperature with electrothermal feedback",
    "category": "Thermal and reliability design",
    "level": "expert",
    "description": "Solve steady junction temperature when device dissipation increases linearly with temperature; reject unstable or out-of-fit equilibria.",
    "formula": "P(Tj)=P_ref[1+beta(Tj-T_ref)]; g=R_th P_ref beta; Tj=Ta+R_th P_ref[1+beta(Ta-T_ref)]/(1-g); P_eq=P_ref[1+beta(Ta-T_ref)]/(1-g)",
    "assumptions": [
      "Reference power and its coefficient represent total internal device dissipation at an unchanged electrical operating point; electrical loss synthesis belongs to other lanes.",
      "Power is locally linear with temperature and beta is nonnegative. Enter the fitted temperature interval from measured or manufacturer data.",
      "R_th is an application-specific junction-to-ambient resistance, not an automatically transferable JEDEC board value; ambient is constant and the model is steady state.",
      "Stability requires R_th P_ref beta < 1. This local lumped equilibrium is not a semiconductor SOA or hotspot certification."
    ],
    "references": [
      {
        "title": "TI SLVA462: Understanding Thermal Dissipation and Design of a Heatsink, pages 1-2",
        "url": "https://www.ti.com/lit/an/slva462/slva462.pdf"
      },
      {
        "title": "TI SNVAAA4: temperature coefficient of MOSFET resistance, Table 2-2 note 2",
        "url": "https://www.ti.com/lit/an/snvaaa4/snvaaa4.pdf"
      },
      {
        "title": "TI SLUA844B: application-dependent thermal metrics",
        "url": "https://www.ti.com/lit/an/slua844b/slua844b.pdf"
      }
    ],
    "inputs": [
      {
        "key": "ambient_temperature",
        "label": "Ambient temperature",
        "unit": "K",
        "default": 298.15,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "reference_temperature",
        "label": "Power reference temperature",
        "unit": "K",
        "default": 298.15,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "reference_power",
        "label": "Device power at reference temperature",
        "unit": "W",
        "default": 2,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "power_coefficient",
        "label": "Fractional power temperature coefficient",
        "unit": "1/K",
        "default": 0.004,
        "min": 0
      },
      {
        "key": "thermal_resistance",
        "label": "Application junction-to-ambient resistance",
        "unit": "K/W",
        "default": 20,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "fit_temperature_min",
        "label": "Minimum validated model temperature",
        "unit": "K",
        "default": 233.15,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "fit_temperature_max",
        "label": "Maximum validated model temperature",
        "unit": "K",
        "default": 423.15,
        "min": 0,
        "exclusive_min": true
      }
    ],
    "outputs": [
      {
        "key": "feedback_gain",
        "label": "Electrothermal feedback gain",
        "unit": "1",
        "expression": "thermal_resistance*reference_power*power_coefficient"
      },
      {
        "key": "junction_temperature",
        "label": "Equilibrium junction temperature",
        "unit": "K",
        "expression": "ambient_temperature+thermal_resistance*reference_power*(1+power_coefficient*(ambient_temperature-reference_temperature))/(1-feedback_gain)"
      },
      {
        "key": "equilibrium_power",
        "label": "Equilibrium device dissipation",
        "unit": "W",
        "expression": "reference_power*(1+power_coefficient*(ambient_temperature-reference_temperature))/(1-feedback_gain)"
      }
    ],
    "constraints": [
      {
        "left": "fit_temperature_max",
        "op": ">",
        "right": "fit_temperature_min",
        "message": "The validated temperature interval must have positive width."
      },
      {
        "left": "ambient_temperature",
        "op": ">=",
        "right": "fit_temperature_min",
        "message": "Ambient must be in the validated fit interval."
      },
      {
        "left": "ambient_temperature",
        "op": "<=",
        "right": "fit_temperature_max",
        "message": "Ambient must be in the validated fit interval."
      },
      {
        "left": "reference_temperature",
        "op": ">=",
        "right": "fit_temperature_min",
        "message": "Reference temperature must be in the validated fit interval."
      },
      {
        "left": "reference_temperature",
        "op": "<=",
        "right": "fit_temperature_max",
        "message": "Reference temperature must be in the validated fit interval."
      },
      {
        "left": "1+power_coefficient*(ambient_temperature-reference_temperature)",
        "op": ">",
        "right": "0",
        "message": "The fitted power at ambient must be positive."
      },
      {
        "left": "thermal_resistance*reference_power*power_coefficient",
        "op": "<",
        "right": "1",
        "message": "Feedback gain must be below unity for a stable equilibrium."
      },
      {
        "left": "ambient_temperature+thermal_resistance*reference_power*(1+power_coefficient*(ambient_temperature-reference_temperature))/(1-thermal_resistance*reference_power*power_coefficient)",
        "op": "<=",
        "right": "fit_temperature_max",
        "message": "Equilibrium exceeds the validated linear-power temperature interval."
      }
    ],
    "example": {
      "inputs": {
        "ambient_temperature": 298.15,
        "reference_temperature": 298.15,
        "reference_power": 2,
        "power_coefficient": 0.004,
        "thermal_resistance": 20,
        "fit_temperature_min": 233.15,
        "fit_temperature_max": 423.15
      },
      "expected": {
        "feedback_gain": 0.16,
        "junction_temperature": 345.7690476190476,
        "equilibrium_power": 2.380952380952381
      },
      "relative_tolerance": 1e-06
    }
  }
]
