[
  {
    "id": "thermal.resistor_power_derating",
    "title": "Linear resistor power derating",
    "category": "Thermal and reliability design",
    "level": "basic",
    "description": "Interpolate a specified flat-then-linear resistor rating curve and compare actual dissipation with the resulting permissible power.",
    "formula": "f=min(1,max(0,(T_zero-Ta)/(T_zero-T_rated))); P_allowed=P_rated f; margin=P_allowed-P_actual",
    "assumptions": [
      "The part datasheet specifies full rated power through T_rated followed by a straight line to zero power at T_zero; parameters are not universal resistor values.",
      "Ta means the datasheet's specified rating reference temperature, ambient for this model. Do not substitute solder-pad temperature unless the curve is defined that way.",
      "Actual dissipation is supplied independently; only continuous power is compared. Pulse overload, limiting voltage, PCB temperature and mounting restrictions still apply.",
      "No power uprating below the full-rating breakpoint. Temperatures above T_zero are rejected rather than described as safe at zero dissipation. Negative power margin signals overload."
    ],
    "references": [
      {
        "title": "Vishay Sfernice 53048: existing derating curves and mounting limitations, sections D-E",
        "url": "https://www.vishay.com/docs/53048/pprachp.pdf"
      }
    ],
    "inputs": [
      {
        "key": "rated_power",
        "label": "Full continuous power rating",
        "unit": "W",
        "default": 0.25,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "rated_temperature",
        "label": "Full-rating temperature breakpoint",
        "unit": "K",
        "default": 343.15,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "zero_power_temperature",
        "label": "Zero-power temperature endpoint",
        "unit": "K",
        "default": 428.15,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "ambient_temperature",
        "label": "Datasheet ambient reference temperature",
        "unit": "K",
        "default": 373.15,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "actual_power",
        "label": "Actual continuous resistor dissipation",
        "unit": "W",
        "default": 0.12,
        "min": 0
      }
    ],
    "outputs": [
      {
        "key": "rating_fraction",
        "label": "Available full-rating fraction",
        "unit": "1",
        "expression": "min(1,max(0,(zero_power_temperature-ambient_temperature)/(zero_power_temperature-rated_temperature)))"
      },
      {
        "key": "allowed_power",
        "label": "Derated continuous power allowance",
        "unit": "W",
        "expression": "rated_power*rating_fraction"
      },
      {
        "key": "power_margin",
        "label": "Power allowance minus actual dissipation",
        "unit": "W",
        "expression": "allowed_power-actual_power"
      }
    ],
    "constraints": [
      {
        "left": "zero_power_temperature",
        "op": ">",
        "right": "rated_temperature",
        "message": "The zero-power endpoint must exceed the full-rating breakpoint."
      },
      {
        "left": "ambient_temperature",
        "op": "<=",
        "right": "zero_power_temperature",
        "message": "Ambient is above the rating curve's maximum temperature endpoint."
      }
    ],
    "example": {
      "inputs": {
        "rated_power": 0.25,
        "rated_temperature": 343.15,
        "zero_power_temperature": 428.15,
        "ambient_temperature": 373.15,
        "actual_power": 0.12
      },
      "expected": {
        "rating_fraction": 0.6470588235294118,
        "allowed_power": 0.16176470588235295,
        "power_margin": 0.04176470588235294
      },
      "relative_tolerance": 1e-06
    }
  },
  {
    "id": "thermal.junction_feedback_equilibrium",
    "title": "Junction temperature with electrothermal feedback",
    "category": "Thermal and reliability design",
    "level": "expert",
    "description": "Solve steady junction temperature when device dissipation increases linearly with temperature; reject unstable or out-of-fit equilibria.",
    "formula": "P(Tj)=P_ref[1+beta(Tj-T_ref)]; g=R_th P_ref beta; Tj=Ta+R_th P_ref[1+beta(Ta-T_ref)]/(1-g); P_eq=P_ref[1+beta(Ta-T_ref)]/(1-g)",
    "assumptions": [
      "Reference power and its coefficient represent total internal device dissipation at an unchanged electrical operating point; electrical loss synthesis belongs to other lanes.",
      "Power is locally linear with temperature and beta is nonnegative. Enter the fitted temperature interval from measured or manufacturer data.",
      "R_th is an application-specific junction-to-ambient resistance, not an automatically transferable JEDEC board value; ambient is constant and the model is steady state.",
      "Stability requires R_th P_ref beta < 1. This local lumped equilibrium is not a semiconductor SOA or hotspot certification."
    ],
    "references": [
      {
        "title": "TI SLVA462: Understanding Thermal Dissipation and Design of a Heatsink, pages 1-2",
        "url": "https://www.ti.com/lit/an/slva462/slva462.pdf"
      },
      {
        "title": "TI SNVAAA4: temperature coefficient of MOSFET resistance, Table 2-2 note 2",
        "url": "https://www.ti.com/lit/an/snvaaa4/snvaaa4.pdf"
      },
      {
        "title": "TI SLUA844B: application-dependent thermal metrics",
        "url": "https://www.ti.com/lit/an/slua844b/slua844b.pdf"
      }
    ],
    "inputs": [
      {
        "key": "ambient_temperature",
        "label": "Ambient temperature",
        "unit": "K",
        "default": 298.15,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "reference_temperature",
        "label": "Power reference temperature",
        "unit": "K",
        "default": 298.15,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "reference_power",
        "label": "Device power at reference temperature",
        "unit": "W",
        "default": 2,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "power_coefficient",
        "label": "Fractional power temperature coefficient",
        "unit": "1/K",
        "default": 0.004,
        "min": 0
      },
      {
        "key": "thermal_resistance",
        "label": "Application junction-to-ambient resistance",
        "unit": "K/W",
        "default": 20,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "fit_temperature_min",
        "label": "Minimum validated model temperature",
        "unit": "K",
        "default": 233.15,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "fit_temperature_max",
        "label": "Maximum validated model temperature",
        "unit": "K",
        "default": 423.15,
        "min": 0,
        "exclusive_min": true
      }
    ],
    "outputs": [
      {
        "key": "feedback_gain",
        "label": "Electrothermal feedback gain",
        "unit": "1",
        "expression": "thermal_resistance*reference_power*power_coefficient"
      },
      {
        "key": "junction_temperature",
        "label": "Equilibrium junction temperature",
        "unit": "K",
        "expression": "ambient_temperature+thermal_resistance*reference_power*(1+power_coefficient*(ambient_temperature-reference_temperature))/(1-feedback_gain)"
      },
      {
        "key": "equilibrium_power",
        "label": "Equilibrium device dissipation",
        "unit": "W",
        "expression": "reference_power*(1+power_coefficient*(ambient_temperature-reference_temperature))/(1-feedback_gain)"
      }
    ],
    "constraints": [
      {
        "left": "fit_temperature_max",
        "op": ">",
        "right": "fit_temperature_min",
        "message": "The validated temperature interval must have positive width."
      },
      {
        "left": "ambient_temperature",
        "op": ">=",
        "right": "fit_temperature_min",
        "message": "Ambient must be in the validated fit interval."
      },
      {
        "left": "ambient_temperature",
        "op": "<=",
        "right": "fit_temperature_max",
        "message": "Ambient must be in the validated fit interval."
      },
      {
        "left": "reference_temperature",
        "op": ">=",
        "right": "fit_temperature_min",
        "message": "Reference temperature must be in the validated fit interval."
      },
      {
        "left": "reference_temperature",
        "op": "<=",
        "right": "fit_temperature_max",
        "message": "Reference temperature must be in the validated fit interval."
      },
      {
        "left": "1+power_coefficient*(ambient_temperature-reference_temperature)",
        "op": ">",
        "right": "0",
        "message": "The fitted power at ambient must be positive."
      },
      {
        "left": "thermal_resistance*reference_power*power_coefficient",
        "op": "<",
        "right": "1",
        "message": "Feedback gain must be below unity for a stable equilibrium."
      },
      {
        "left": "ambient_temperature+thermal_resistance*reference_power*(1+power_coefficient*(ambient_temperature-reference_temperature))/(1-thermal_resistance*reference_power*power_coefficient)",
        "op": "<=",
        "right": "fit_temperature_max",
        "message": "Equilibrium exceeds the validated linear-power temperature interval."
      }
    ],
    "example": {
      "inputs": {
        "ambient_temperature": 298.15,
        "reference_temperature": 298.15,
        "reference_power": 2,
        "power_coefficient": 0.004,
        "thermal_resistance": 20,
        "fit_temperature_min": 233.15,
        "fit_temperature_max": 423.15
      },
      "expected": {
        "feedback_gain": 0.16,
        "junction_temperature": 345.7690476190476,
        "equilibrium_power": 2.380952380952381
      },
      "relative_tolerance": 1e-06
    }
  },
  {
    "id": "thermal.arrhenius_acceleration",
    "title": "Arrhenius accelerated-life exposure",
    "category": "Thermal and reliability design",
    "level": "expert",
    "description": "Convert higher-temperature exposure to equivalent use-temperature exposure for a single characterized thermally activated failure mechanism.",
    "formula": "AF=exp[(Ea/k_B)(1/T_use-1/T_test)]; t_equivalent=AF t_test; k_B=8.617333262145e-5 eV/K",
    "assumptions": [
      "The same single thermally activated failure mechanism governs both temperatures, with constant activation energy and unchanged other stresses.",
      "Temperatures are absolute temperatures at the failure site, not necessarily chamber or ambient temperatures.",
      "Activation energy is an experimentally characterized material/mechanism parameter; the default 0.7 eV is illustrative, not universal.",
      "Equivalent exposure is not guaranteed service life, MTBF, or a reliability confidence bound. Not applicable to generic solder fatigue or changing failure mechanisms.",
      "The logarithmic numerical-domain guard limits factor and equivalent exposure to at most 1e300 to avoid floating-point overflow.",
      "Evaluate the reciprocal-temperature difference as ((T_test-T_use)/T_test)/T_use to avoid subtracting nearly equal reciprocals; the overflow guard uses this same expression."
    ],
    "references": [
      {
        "title": "NIST/SEMATECH e-Handbook section 8.1.5.1: Arrhenius model",
        "url": "https://www.itl.nist.gov/div898/handbook/apr/section1/apr151.htm"
      },
      {
        "title": "NIST CODATA: Boltzmann constant in eV/K",
        "url": "https://physics.nist.gov/cgi-bin/cuu/Value?kev"
      }
    ],
    "inputs": [
      {
        "key": "activation_energy",
        "label": "Characterized activation energy",
        "unit": "eV",
        "default": 0.7,
        "min": 0,
        "max": 10,
        "exclusive_min": true
      },
      {
        "key": "use_temperature",
        "label": "Use failure-site temperature",
        "unit": "K",
        "default": 328.15,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "test_temperature",
        "label": "Accelerated-test failure-site temperature",
        "unit": "K",
        "default": 398.15,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "test_duration",
        "label": "Test exposure duration",
        "unit": "s",
        "default": 360000,
        "min": 0,
        "max": 1e+100
      }
    ],
    "outputs": [
      {
        "key": "acceleration_factor",
        "label": "Use-to-test time acceleration factor",
        "unit": "1",
        "expression": "exp(activation_energy/8.617333262145e-5*((test_temperature-use_temperature)/test_temperature)/use_temperature)"
      },
      {
        "key": "equivalent_use_duration",
        "label": "Equivalent use-temperature exposure",
        "unit": "s",
        "expression": "test_duration*acceleration_factor"
      }
    ],
    "constraints": [
      {
        "left": "test_temperature",
        "op": ">=",
        "right": "use_temperature",
        "message": "Accelerated-test temperature must be at least the use temperature."
      },
      {
        "left": "activation_energy/8.617333262145e-5*((test_temperature-use_temperature)/test_temperature)/use_temperature",
        "op": "<=",
        "right": "ln(1e300/max(test_duration,1))",
        "message": "Requested acceleration factor or equivalent exposure exceeds the finite numerical domain."
      }
    ],
    "example": {
      "inputs": {
        "activation_energy": 0.7,
        "use_temperature": 328.15,
        "test_temperature": 398.15,
        "test_duration": 360000
      },
      "expected": {
        "acceleration_factor": 77.64538204961666,
        "equivalent_use_duration": 27952337.537862
      },
      "relative_tolerance": 1e-06
    }
  },
  {
    "id": "thermal.heatsink_resistance_budget",
    "title": "Maximum heatsink thermal resistance",
    "category": "Thermal and reliability design",
    "level": "intermediate",
    "description": "Allocate a junction-temperature budget to a package, interface and heatsink in a dominant series cooling path.",
    "formula": "R_total,max=(Tj_limit-Ta)/P; R_sa,max=R_total,max-R_jc-R_cs",
    "assumptions": [
      "Steady, temperature-independent dissipation supplied by an electrical loss calculation.",
      "Almost all heat flows through the specified case face, interface and heatsink; do not mix datasheet R_theta_JA with this chain.",
      "Heatsink resistance must be characterized at actual airflow, orientation, enclosure and mounting conditions. Smaller resistance is better.",
      "Positive sink resistance headroom is required; a nonpositive budget means the package/interface already consume the temperature allowance."
    ],
    "references": [
      {
        "title": "TI SLVA462: heatsink design, equations 3-4 and airflow caveats",
        "url": "https://www.ti.com/lit/an/slva462/slva462.pdf"
      },
      {
        "title": "TI SLUA844B: junction-to-case single-surface applicability, page 5",
        "url": "https://www.ti.com/lit/an/slua844b/slua844b.pdf"
      }
    ],
    "inputs": [
      {
        "key": "ambient_temperature",
        "label": "Ambient temperature",
        "unit": "K",
        "default": 313.15,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "junction_limit",
        "label": "Design junction-temperature limit",
        "unit": "K",
        "default": 393.15,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "dissipated_power",
        "label": "Device dissipated power",
        "unit": "W",
        "default": 10,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "junction_case_resistance",
        "label": "Junction-to-case thermal resistance",
        "unit": "K/W",
        "default": 1.5,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "case_sink_resistance",
        "label": "Case-to-sink interface resistance",
        "unit": "K/W",
        "default": 0.5,
        "min": 0
      }
    ],
    "outputs": [
      {
        "key": "total_resistance_budget",
        "label": "Total junction-to-ambient budget",
        "unit": "K/W",
        "expression": "(junction_limit-ambient_temperature)/dissipated_power"
      },
      {
        "key": "maximum_sink_resistance",
        "label": "Maximum heatsink-to-ambient resistance",
        "unit": "K/W",
        "expression": "total_resistance_budget-junction_case_resistance-case_sink_resistance"
      }
    ],
    "constraints": [
      {
        "left": "junction_limit",
        "op": ">",
        "right": "ambient_temperature",
        "message": "Design junction limit must exceed ambient temperature."
      },
      {
        "left": "(junction_limit-ambient_temperature)/dissipated_power-junction_case_resistance-case_sink_resistance",
        "op": ">",
        "right": "0",
        "message": "No positive heatsink resistance allowance remains after package and interface losses."
      }
    ],
    "example": {
      "inputs": {
        "ambient_temperature": 313.15,
        "junction_limit": 393.15,
        "dissipated_power": 10,
        "junction_case_resistance": 1.5,
        "case_sink_resistance": 0.5
      },
      "expected": {
        "total_resistance_budget": 8,
        "maximum_sink_resistance": 6
      },
      "relative_tolerance": 1e-06
    }
  }
]
