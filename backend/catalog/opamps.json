      },
      {
        "key": "v_out",
        "label": "Output during ramp interior",
        "unit": "V",
        "expression": "v_reference-r_feedback*c_input*input_slope"
      }
    ],
    "constraints": [
      {
        "left": "v_out_min",
        "op": "<",
        "right": "v_out_max",
        "message": "Output limits must be ordered."
      },
      {
        "left": "v_cm_min",
        "op": "<",
        "right": "v_cm_max",
        "message": "Input common-mode limits must be ordered."
      },
      {
        "left": "v_reference",
        "op": ">=",
        "right": "v_cm_min",
        "message": "Reference is below the input common-mode range."
      },
      {
        "left": "v_reference",
        "op": "<=",
        "right": "v_cm_max",
        "message": "Reference is above the input common-mode range."
      },
      {
        "left": "v_reference-r_feedback*c_input*(v_end-v_start)/duration",
        "op": ">=",
        "right": "v_out_min",
        "message": "Predicted output is below the linear output range."
      },
      {
        "left": "v_reference-r_feedback*c_input*(v_end-v_start)/duration",
        "op": "<=",
        "right": "v_out_max",
        "message": "Predicted output is above the linear output range."
      }
    ],
    "example": {
