        "exclusive_min": true
      },
      {
        "key": "v_start",
        "label": "Ramp starting voltage",
        "unit": "V",
        "default": -0.5
      },
      {
        "key": "v_end",
        "label": "Ramp ending voltage",
        "unit": "V",
        "default": 0.5
      },
      {
        "key": "duration",
        "label": "Ramp duration",
        "unit": "s",
        "default": 0.001,
        "min": 0.0,
        "exclusive_min": true
      },
      {
        "key": "v_reference",
        "label": "Noninverting reference voltage",
        "unit": "V",
        "default": 0.0
      },
      {
        "key": "v_out_min",
        "label": "Minimum linear output voltage",
        "unit": "V",
        "default": -10.0
      },
      {
        "key": "v_out_max",
        "label": "Maximum linear output voltage",
        "unit": "V",
        "default": 10.0
      },
      {
        "key": "v_cm_min",
        "label": "Minimum input common-mode voltage",
        "unit": "V",
        "default": -10.0
      },
      {
        "key": "v_cm_max",
        "label": "Maximum input common-mode voltage",
        "unit": "V",
        "default": 10.0
      }
    ],
    "outputs": [
      {
        "key": "input_slope",
