[
  {
    "id": "opamps.inverting_stage",
    "title": "Inverting amplifier with reference bias",
    "category": "Operational amplifier stages",
    "level": "basic",
    "description": "Calculate signed voltage gain and output for a resistive inverting stage referred to a fixed noninverting-input voltage.",
    "formula": "G = -Rf/Rin; Vo = Vref + G(Vin - Vref)",
    "assumptions": [
      "Ideal, stable negative feedback; negligible offset and input bias currents.",
      "Voltages are DC or sufficiently slow that finite bandwidth and slew rate are negligible.",
      "Source resistance is included in Rin; output load remains within the selected device's drive capability.",
      "Entered output and input common-mode limits are device operating limits at the actual supply, load and temperature, not necessarily supply rails."
    ],
    "references": [
      {
        "title": "TI SBOA092B: Handbook of Operational Amplifier Applications, pp. 18-19",
        "url": "https://www.ti.com/lit/an/sboa092b/sboa092b.pdf"
      },
      {
        "title": "TI SLOA011B: Understanding Operational Amplifier Specifications, sections 3, 5.4 and 5.6",
        "url": "https://www.ti.com/lit/an/sloa011b/sloa011b.pdf"
      }
    ],
    "inputs": [
      {
        "key": "r_in",
        "label": "Total input resistance",
        "unit": "ohm",
        "default": 10000.0,
        "min": 0.0,
        "exclusive_min": true
      },
      {
        "key": "r_feedback",
        "label": "Feedback resistance",
        "unit": "ohm",
        "default": 47000.0,
        "min": 0.0,
        "exclusive_min": true
      },
      {
        "key": "v_in",
        "label": "Input voltage",
        "unit": "V",
        "default": 0.2
      },
      {
        "key": "v_reference",
        "label": "Noninverting reference voltage",
        "unit": "V",
        "default": 0.0
      },
      {
        "key": "v_out_min",
        "label": "Minimum linear output voltage",
        "unit": "V",
        "default": -10.0
      },
      {
        "key": "v_out_max",
        "label": "Maximum linear output voltage",
        "unit": "V",
        "default": 10.0
      },
      {
        "key": "v_cm_min",
        "label": "Minimum input common-mode voltage",
        "unit": "V",
        "default": -10.0
      },
      {
        "key": "v_cm_max",
        "label": "Maximum input common-mode voltage",
        "unit": "V",
        "default": 10.0
      }
    ],
    "outputs": [
      {
        "key": "gain",
        "label": "Signed signal gain",
        "unit": "V/V",
        "expression": "-r_feedback/r_in"
      },
      {
        "key": "v_out",
        "label": "Output voltage",
        "unit": "V",
        "expression": "v_reference+gain*(v_in-v_reference)"
      }
    ],
    "constraints": [
      {
        "left": "v_out_min",
        "op": "<",
        "right": "v_out_max",
        "message": "Output limits must be ordered."
      },
      {
        "left": "v_cm_min",
        "op": "<",
        "right": "v_cm_max",
        "message": "Input common-mode limits must be ordered."
      },
      {
        "left": "v_reference",
        "op": ">=",
        "right": "v_cm_min",
        "message": "Reference is below the input common-mode range."
      },
      {
        "left": "v_reference",
        "op": "<=",
        "right": "v_cm_max",
        "message": "Reference is above the input common-mode range."
      },
      {
        "left": "v_reference-r_feedback/r_in*(v_in-v_reference)",
        "op": ">=",
        "right": "v_out_min",
        "message": "Predicted output is below the linear output range."
      },
      {
        "left": "v_reference-r_feedback/r_in*(v_in-v_reference)",
        "op": "<=",
        "right": "v_out_max",
        "message": "Predicted output is above the linear output range."
      }
    ],
    "example": {
      "inputs": {
        "r_in": 10000.0,
        "r_feedback": 47000.0,
        "v_in": 0.2,
        "v_reference": 0.0,
        "v_out_min": -10.0,
        "v_out_max": 10.0,
        "v_cm_min": -10.0,
        "v_cm_max": 10.0
      },
      "expected": {
        "gain": -4.7,
        "v_out": -0.94
      },
      "relative_tolerance": 1e-06
    }
  },
  {
    "id": "opamps.difference_ratio_error",
    "title": "Difference amplifier resistor-ratio error",
    "category": "Operational amplifier stages",
    "level": "expert",
    "description": "Predict differential gain, common-mode leakage and output for a four-resistor difference stage with unequal resistor ratios.",
    "formula": "k = R2/R1; p = R4/(R3+R4); Vpin = p V2 + (1-p)Vref; Vo = (1+k)Vpin-k V1; Ad = ((1+k)p+k)/2; Acm = (1+k)p-k; Acm = (R4/R3-k)/(1+R4/R3) (equivalent matched-ratio-safe form)",
    "assumptions": [
      "R1 connects V1 to the inverting input; R2 is feedback; R3 connects V2 to the noninverting input; R4 connects the noninverting input to Vref.",
      "Ad is defined for Vd=V2-V1 with Vcm=(V1+V2)/2 held constant. Acm describes external resistor-ratio leakage, not intrinsic op-amp CMRR.",
      "Ideal stable op amp; negligible bias, offset and finite-open-loop effects; source impedances are negligible or incorporated into R1 and R3.",
      "Use actual resistor values to study mismatch; no tolerance distribution or noise model is implied. Matched ratios are valid and yield zero Acm; CMRR is deliberately not divided by zero.",
      "DC or slow signals and adequate output drive. Enter actual pin common-mode and linear output limits.",
      "Common-mode gain is computed by subtracting the resistor ratios before division; identical computed ratios return exactly zero without subtracting separately rounded divider/gain products. Extremely small mismatches remain limited by floating-point resolution of the supplied resistor values."
    ],
    "references": [
      {
        "title": "TI SBOA092B: Handbook of Operational Amplifier Applications, pp. 24-25 and 74-75",
        "url": "https://www.ti.com/lit/an/sboa092b/sboa092b.pdf"
      }
    ],
    "inputs": [
      {
        "key": "r_one",
        "label": "Inverting input resistor R1",
        "unit": "ohm",
        "default": 10000.0,
        "min": 0.0,
        "exclusive_min": true
      },
      {
        "key": "r_two",
        "label": "Feedback resistor R2",
        "unit": "ohm",
        "default": 100000.0,
        "min": 0.0,
        "exclusive_min": true
      },
      {
        "key": "r_three",
        "label": "Noninverting input resistor R3",
        "unit": "ohm",
        "default": 10000.0,
        "min": 0.0,
        "exclusive_min": true
      },
      {
        "key": "r_four",
        "label": "Reference resistor R4",
        "unit": "ohm",
        "default": 101000.0,
        "min": 0.0,
        "exclusive_min": true
      },
      {
        "key": "v_one",
        "label": "Inverting-side source V1",
        "unit": "V",
        "default": 1.0
      },
      {
        "key": "v_two",
        "label": "Noninverting-side source V2",
        "unit": "V",
        "default": 1.1
      },
      {
        "key": "v_reference",
        "label": "Reference voltage",
        "unit": "V",
        "default": 0.0
      },
      {
        "key": "v_out_min",
        "label": "Minimum linear output voltage",
        "unit": "V",
        "default": -10.0
      },
      {
        "key": "v_out_max",
        "label": "Maximum linear output voltage",
        "unit": "V",
        "default": 10.0
      },
      {
        "key": "v_cm_min",
        "label": "Minimum input-pin common-mode voltage",
        "unit": "V",
        "default": -10.0
      },
      {
        "key": "v_cm_max",
        "label": "Maximum input-pin common-mode voltage",
        "unit": "V",
        "default": 10.0
      }
    ],
    "outputs": [
      {
        "key": "differential_gain",
        "label": "Differential-mode gain",
        "unit": "V/V",
        "expression": "((1+r_two/r_one)*r_four/(r_three+r_four)+r_two/r_one)/2"
      },
      {
        "key": "common_mode_gain",
        "label": "Resistor-induced common-mode gain",
        "unit": "V/V",
        "expression": "(r_four/r_three-r_two/r_one)/(1+r_four/r_three)"
      },
      {
        "key": "pin_voltage",
        "label": "Op-amp input-pin common-mode voltage",
        "unit": "V",
        "expression": "(r_four*v_two+r_three*v_reference)/(r_three+r_four)"
      },
      {
        "key": "v_out",
        "label": "Output voltage",
        "unit": "V",
        "expression": "(1+r_two/r_one)*pin_voltage-r_two/r_one*v_one"
      }
    ],
    "constraints": [
      {
        "left": "v_out_min",
        "op": "<",
        "right": "v_out_max",
        "message": "Output limits must be ordered."
      },
      {
        "left": "v_cm_min",
        "op": "<",
        "right": "v_cm_max",
        "message": "Input common-mode limits must be ordered."
      },
      {
        "left": "(r_four*v_two+r_three*v_reference)/(r_three+r_four)",
        "op": ">=",
        "right": "v_cm_min",
        "message": "Input-pin voltage is below the common-mode range."
      },
      {
        "left": "(r_four*v_two+r_three*v_reference)/(r_three+r_four)",
        "op": "<=",
        "right": "v_cm_max",
        "message": "Input-pin voltage is above the common-mode range."
      },
      {
        "left": "(1+r_two/r_one)*(r_four*v_two+r_three*v_reference)/(r_three+r_four)-r_two/r_one*v_one",
        "op": ">=",
        "right": "v_out_min",
        "message": "Predicted output is below the linear output range."
      },
      {
        "left": "(1+r_two/r_one)*(r_four*v_two+r_three*v_reference)/(r_three+r_four)-r_two/r_one*v_one",
        "op": "<=",
        "right": "v_out_max",
        "message": "Predicted output is above the linear output range."
      }
    ],
    "example": {
      "inputs": {
        "r_one": 10000.0,
        "r_two": 100000.0,
        "r_three": 10000.0,
        "r_four": 101000.0,
        "v_one": 1.0,
        "v_two": 1.1,
        "v_reference": 0.0,
        "v_out_min": -10.0,
        "v_out_max": 10.0,
        "v_cm_min": -10.0,
        "v_cm_max": 10.0
      },
      "expected": {
        "differential_gain": 10.004504504504505,
        "common_mode_gain": 0.009009009009009009,
        "pin_voltage": 1.000900900900901,
        "v_out": 1.0099099099099098
      },
      "relative_tolerance": 1e-06
    }
  },
  {
    "id": "opamps.dominant_pole_gain_bandwidth",
    "title": "Finite-gain dominant-pole amplifier bandwidth",
    "category": "Operational amplifier stages",
    "level": "expert",
    "description": "Estimate resistive-feedback bandwidth and finite-open-loop gain error, distinguishing noise gain from inverting signal gain.",
    "formula": "N = 1+Rf/Rg; fp = GBW/A0; Gdc = A0/(1+A0/N); fcl = fp(1+A0/N); fcl_approx = GBW/N; relative_error = 1/(1+A0/N)",
    "assumptions": [
      "Voltage-feedback op amp modeled as A(s)=A0/(1+s/(2 pi fp)); purely resistive, frequency-independent feedback factor beta=1/N.",
      "GBW denotes the dominant-pole asymptote A0*fp, not the exact unity-gain crossing. Exact single-pole unity crossing is fp*sqrt(A0^2-1). The distinction is negligible at large A0 but remains conceptually important.",
      "Gdc is the noninverting/noise-path gain. For an inverting stage, signed DC signal gain is -(Rf/Rg)/(1+N/A0), not Gdc; both stages have the same modeled pole for the same feedback network.",
      "Rg is the resistance from the inverting input to AC ground with independent sources suppressed, including source resistance. Purely resistive source/feedback networks only.",
      "Single-pole approximation only; additional poles, capacitive loading, feedback parasitics, current-feedback amplifiers and slew limitation are excluded. This is not a stability certification.",
      "Minimum stable noise gain is entered from device documentation; the catalog checks N against that requirement. GBW and A0 must be taken at matching supply, load and temperature."
    ],
    "references": [
      {
        "title": "TI SLOA185: Extending Op Amp Bandwidth using Active Feedback Phase Correction, section 4, equations 1-3",
        "url": "https://www.ti.com/lit/an/sloa185/sloa185.pdf"
      },
      {
        "title": "TI SLOA011B: Understanding Operational Amplifier Specifications, sections 2.1 and 5.16",
        "url": "https://www.ti.com/lit/an/sloa011b/sloa011b.pdf"
      }
    ],
    "inputs": [
      {
        "key": "r_ground",
        "label": "Resistance to AC ground",
        "unit": "ohm",
        "default": 10000.0,
        "min": 0.0,
        "exclusive_min": true
      },
      {
        "key": "r_feedback",
        "label": "Feedback resistance",
        "unit": "ohm",
        "default": 90000.0,
        "min": 0.0
      },
      {
        "key": "open_loop_gain",
        "label": "DC open-loop voltage gain A0",
        "unit": "V/V",
        "default": 100000.0,
        "min": 1.0,
        "exclusive_min": true
      },
      {
        "key": "gain_bandwidth",
        "label": "Dominant-pole asymptotic GBW",
        "unit": "Hz",
        "default": 10000000.0,
        "min": 0.0,
        "exclusive_min": true
      },
      {
        "key": "minimum_stable_noise_gain",
        "label": "Device minimum stable noise gain",
        "unit": "V/V",
        "default": 1.0,
        "min": 1.0
      }
    ],
    "outputs": [
      {
        "key": "noise_gain",
        "label": "Ideal noise gain",
        "unit": "V/V",
        "expression": "1+r_feedback/r_ground"
      },
      {
        "key": "open_loop_pole",
        "label": "Open-loop dominant pole",
        "unit": "Hz",
        "expression": "gain_bandwidth/open_loop_gain"
      },
      {
        "key": "dc_gain",
        "label": "Finite noninverting/noise-path DC gain",
        "unit": "V/V",
        "expression": "open_loop_gain/(1+open_loop_gain/noise_gain)"
      },
      {
        "key": "closed_loop_bandwidth",
        "label": "Single-pole closed-loop minus-3-dB bandwidth",
        "unit": "Hz",
        "expression": "open_loop_pole*(1+open_loop_gain/noise_gain)"
      },
      {
        "key": "approximate_bandwidth",
        "label": "High-loop-gain bandwidth approximation",
        "unit": "Hz",
        "expression": "gain_bandwidth/noise_gain"
      },
      {
        "key": "relative_gain_error",
        "label": "Fractional DC gain deficit from ideal",
        "unit": "1",
        "expression": "1/(1+open_loop_gain/noise_gain)"
      }
    ],
    "constraints": [
      {
        "left": "1+r_feedback/r_ground",
        "op": ">=",
        "right": "minimum_stable_noise_gain",
        "message": "Feedback noise gain is below the device minimum stable gain."
      }
    ],
    "example": {
      "inputs": {
        "r_ground": 10000.0,
        "r_feedback": 90000.0,
        "open_loop_gain": 100000.0,
        "gain_bandwidth": 10000000.0,
        "minimum_stable_noise_gain": 1.0
      },
      "expected": {
        "noise_gain": 10.0,
        "open_loop_pole": 100.0,
        "dc_gain": 9.99900009999,
        "closed_loop_bandwidth": 1000100.0,
        "approximate_bandwidth": 1000000.0,
        "relative_gain_error": 9.999000099990002e-05
      },
      "relative_tolerance": 1e-06
    }
  },
  {
    "id": "opamps.noninverting_stage",
    "title": "Noninverting amplifier with reference bias",
    "category": "Operational amplifier stages",
    "level": "basic",
    "description": "Calculate the high-input-impedance noninverting stage's gain and level-shifted output.",
    "formula": "G = 1 + Rf/Rg; Vo = Vref + G(Vin - Vref)",
    "assumptions": [
      "Rg connects the inverting node to Vref and Rf connects that node to the output; Vin drives the noninverting input.",
      "Ideal, stable negative feedback; negligible bias current, offset and source loading.",
      "DC or slow signals; finite gain, bandwidth, slew rate and load current limitations are not modeled.",
      "Entered common-mode limits apply to Vin; output limits are the actual device linear-swing limits."
    ],
    "references": [
      {
        "title": "TI SBOA092B: Handbook of Operational Amplifier Applications, p. 17",
        "url": "https://www.ti.com/lit/an/sboa092b/sboa092b.pdf"
      },
      {
        "title": "TI SLOA011B: Understanding Operational Amplifier Specifications, section 2",
        "url": "https://www.ti.com/lit/an/sloa011b/sloa011b.pdf"
      }
    ],
    "inputs": [
      {
        "key": "r_ground",
        "label": "Resistance to reference",
        "unit": "ohm",
        "default": 10000.0,
        "min": 0.0,
        "exclusive_min": true
      },
      {
        "key": "r_feedback",
        "label": "Feedback resistance",
        "unit": "ohm",
        "default": 90000.0,
        "min": 0.0
      },
      {
        "key": "v_in",
        "label": "Noninverting input voltage",
        "unit": "V",
        "default": 0.4
      },
      {
        "key": "v_reference",
        "label": "Feedback-divider reference",
        "unit": "V",
        "default": 0.1
      },
      {
        "key": "v_out_min",
        "label": "Minimum linear output voltage",
        "unit": "V",
        "default": -10.0
      },
      {
        "key": "v_out_max",
        "label": "Maximum linear output voltage",
        "unit": "V",
        "default": 10.0
      },
      {
        "key": "v_cm_min",
        "label": "Minimum input common-mode voltage",
        "unit": "V",
        "default": -10.0
      },
      {
        "key": "v_cm_max",
        "label": "Maximum input common-mode voltage",
        "unit": "V",
        "default": 10.0
      }
    ],
    "outputs": [
      {
        "key": "gain",
        "label": "Signal gain",
        "unit": "V/V",
        "expression": "1+r_feedback/r_ground"
      },
      {
        "key": "v_out",
        "label": "Output voltage",
        "unit": "V",
        "expression": "v_reference+gain*(v_in-v_reference)"
      }
    ],
    "constraints": [
      {
        "left": "v_out_min",
        "op": "<",
        "right": "v_out_max",
        "message": "Output limits must be ordered."
      },
      {
        "left": "v_cm_min",
        "op": "<",
        "right": "v_cm_max",
        "message": "Input common-mode limits must be ordered."
      },
      {
        "left": "v_in",
        "op": ">=",
        "right": "v_cm_min",
        "message": "Input is below the common-mode range."
      },
      {
        "left": "v_in",
        "op": "<=",
        "right": "v_cm_max",
        "message": "Input is above the common-mode range."
      },
      {
        "left": "v_reference+(1+r_feedback/r_ground)*(v_in-v_reference)",
        "op": ">=",
        "right": "v_out_min",
        "message": "Predicted output is below the linear output range."
      },
      {
        "left": "v_reference+(1+r_feedback/r_ground)*(v_in-v_reference)",
        "op": "<=",
        "right": "v_out_max",
        "message": "Predicted output is above the linear output range."
      }
    ],
    "example": {
      "inputs": {
        "r_ground": 10000.0,
        "r_feedback": 90000.0,
        "v_in": 0.4,
        "v_reference": 0.1,
        "v_out_min": -10.0,
        "v_out_max": 10.0,
        "v_cm_min": -10.0,
        "v_cm_max": 10.0
      },
      "expected": {
        "gain": 10.0,
        "v_out": 3.1
      },
      "relative_tolerance": 1e-06
    }
  },
  {
    "id": "opamps.weighted_summing_stage",
    "title": "Three-input weighted summing amplifier",
    "category": "Operational amplifier stages",
    "level": "intermediate",
    "description": "Calculate each source's weight and the signed output of a three-input inverting summing stage.",
    "formula": "Gi = -Rf/Ri; Vo = Vref - Rf[(V1-Vref)/R1+(V2-Vref)/R2+(V3-Vref)/R3]",
    "assumptions": [
      "Three independent low-impedance voltage sources drive individual resistors into the inverting summing node; the noninverting input is held at Vref.",
      "Ideal stable negative feedback, negligible bias and offset, DC or slow signals; adequate output current capability.",
      "Each source resistance is included in its respective input resistor; no shorting together of voltage sources is assumed.",
      "Entered input common-mode limits apply to Vref, not the independent source voltages; output limits are actual device linear-swing limits."
    ],
    "references": [
      {
        "title": "TI SBOA092B: Handbook of Operational Amplifier Applications, pp. 23-24, Scaling Summer",
        "url": "https://www.ti.com/lit/an/sboa092b/sboa092b.pdf"
      }
    ],
    "inputs": [
      {
        "key": "r_one",
        "label": "Input resistance R1",
        "unit": "ohm",
        "default": 10000.0,
        "min": 0.0,
        "exclusive_min": true
      },
      {
        "key": "r_two",
        "label": "Input resistance R2",
        "unit": "ohm",
        "default": 20000.0,
        "min": 0.0,
        "exclusive_min": true
      },
      {
        "key": "r_three",
        "label": "Input resistance R3",
        "unit": "ohm",
        "default": 40000.0,
        "min": 0.0,
        "exclusive_min": true
      },
      {
        "key": "r_feedback",
        "label": "Feedback resistance",
        "unit": "ohm",
        "default": 40000.0,
        "min": 0.0,
        "exclusive_min": true
      },
      {
        "key": "v_one",
        "label": "Input voltage V1",
        "unit": "V",
        "default": 0.2
      },
      {
        "key": "v_two",
        "label": "Input voltage V2",
        "unit": "V",
        "default": -0.3
      },
      {
        "key": "v_three",
        "label": "Input voltage V3",
        "unit": "V",
        "default": 0.4
      },
      {
        "key": "v_reference",
        "label": "Noninverting reference voltage",
        "unit": "V",
        "default": 0.0
      },
      {
        "key": "v_out_min",
        "label": "Minimum linear output voltage",
        "unit": "V",
        "default": -10.0
      },
      {
        "key": "v_out_max",
        "label": "Maximum linear output voltage",
        "unit": "V",
        "default": 10.0
      },
      {
        "key": "v_cm_min",
        "label": "Minimum input common-mode voltage",
        "unit": "V",
        "default": -10.0
      },
      {
        "key": "v_cm_max",
        "label": "Maximum input common-mode voltage",
        "unit": "V",
        "default": 10.0
      }
    ],
    "outputs": [
      {
        "key": "gain_one",
        "label": "Source V1 gain",
        "unit": "V/V",
        "expression": "-r_feedback/r_one"
      },
      {
        "key": "gain_two",
        "label": "Source V2 gain",
        "unit": "V/V",
        "expression": "-r_feedback/r_two"
      },
      {
        "key": "gain_three",
        "label": "Source V3 gain",
        "unit": "V/V",
        "expression": "-r_feedback/r_three"
      },
      {
        "key": "v_out",
        "label": "Summed output voltage",
        "unit": "V",
        "expression": "v_reference+gain_one*(v_one-v_reference)+gain_two*(v_two-v_reference)+gain_three*(v_three-v_reference)"
      }
    ],
    "constraints": [
      {
        "left": "v_out_min",
        "op": "<",
        "right": "v_out_max",
        "message": "Output limits must be ordered."
      },
      {
        "left": "v_cm_min",
        "op": "<",
        "right": "v_cm_max",
        "message": "Input common-mode limits must be ordered."
      },
      {
        "left": "v_reference",
        "op": ">=",
        "right": "v_cm_min",
        "message": "Reference is below the input common-mode range."
      },
      {
        "left": "v_reference",
        "op": "<=",
        "right": "v_cm_max",
        "message": "Reference is above the input common-mode range."
      },
      {
        "left": "v_reference-r_feedback*((v_one-v_reference)/r_one+(v_two-v_reference)/r_two+(v_three-v_reference)/r_three)",
        "op": ">=",
        "right": "v_out_min",
        "message": "Predicted output is below the linear output range."
      },
      {
        "left": "v_reference-r_feedback*((v_one-v_reference)/r_one+(v_two-v_reference)/r_two+(v_three-v_reference)/r_three)",
        "op": "<=",
        "right": "v_out_max",
        "message": "Predicted output is above the linear output range."
      }
    ],
    "example": {
      "inputs": {
        "r_one": 10000.0,
        "r_two": 20000.0,
        "r_three": 40000.0,
        "r_feedback": 40000.0,
        "v_one": 0.2,
        "v_two": -0.3,
        "v_three": 0.4,
        "v_reference": 0.0,
        "v_out_min": -10.0,
        "v_out_max": 10.0,
        "v_cm_min": -10.0,
        "v_cm_max": 10.0
      },
      "expected": {
        "gain_one": -4.0,
        "gain_two": -2.0,
        "gain_three": -1.0,
        "v_out": -0.6
      },
      "relative_tolerance": 1e-06
    }
  },
  {
    "id": "opamps.integrator_constant_input",
    "title": "Integrator constant-input ramp",
    "category": "Operational amplifier stages",
    "level": "intermediate",
    "description": "Predict an ideal feedback-capacitor integrator's output slope and finite-interval final voltage from a known initial state.",
    "formula": "dVo/dt = -(Vin-Vref)/(R C); Vo(t) = Vo_initial - (Vin-Vref)t/(R C)",
    "assumptions": [
      "R is the input resistor and C is the feedback capacitor; the noninverting input is held at a constant Vref.",
      "Input is constant throughout the interval; initial output is set by the capacitor's known initial charge or a reset operation.",
      "Ideal stable op amp, lossless capacitor, no parallel bleed resistor, negligible bias current and offset. Real integrators drift or saturate and usually require reset or DC stabilization.",
      "The model applies after startup transients while output slew and bandwidth are adequate; it does not predict reset-switch behavior or passive capacitor charging.",
      "Both endpoint outputs must be inside the actual linear-swing range. A constant slope makes these endpoint checks sufficient throughout the interval."
    ],
    "references": [
      {
        "title": "TI SBOA092B: Handbook of Operational Amplifier Applications, p. 21 and pp. 55-58",
        "url": "https://www.ti.com/lit/an/sboa092b/sboa092b.pdf"
      }
    ],
    "inputs": [
      {
        "key": "r_input",
        "label": "Input resistance",
        "unit": "ohm",
        "default": 10000.0,
        "min": 0.0,
        "exclusive_min": true
      },
      {
        "key": "c_feedback",
        "label": "Feedback capacitance",
        "unit": "F",
        "default": 1e-07,
        "min": 0.0,
        "exclusive_min": true
      },
      {
        "key": "v_in",
        "label": "Constant input voltage",
        "unit": "V",
        "default": 0.25
      },
      {
        "key": "v_reference",
        "label": "Noninverting reference voltage",
        "unit": "V",
        "default": 0.0
      },
      {
        "key": "v_initial",
        "label": "Initial output voltage",
        "unit": "V",
        "default": 1.0
      },
      {
        "key": "duration",
        "label": "Integration interval",
        "unit": "s",
        "default": 0.002,
        "min": 0.0
      },
      {
        "key": "v_out_min",
        "label": "Minimum linear output voltage",
        "unit": "V",
        "default": -10.0
      },
      {
        "key": "v_out_max",
        "label": "Maximum linear output voltage",
        "unit": "V",
        "default": 10.0
      },
      {
        "key": "v_cm_min",
        "label": "Minimum input common-mode voltage",
        "unit": "V",
        "default": -10.0
      },
      {
        "key": "v_cm_max",
        "label": "Maximum input common-mode voltage",
        "unit": "V",
        "default": 10.0
      }
    ],
    "outputs": [
      {
        "key": "output_slope",
        "label": "Output ramp slope",
        "unit": "V/s",
        "expression": "-(v_in-v_reference)/(r_input*c_feedback)"
      },
      {
        "key": "v_final",
        "label": "Final output voltage",
        "unit": "V",
        "expression": "v_initial+output_slope*duration"
      }
    ],
    "constraints": [
      {
        "left": "v_out_min",
        "op": "<",
        "right": "v_out_max",
        "message": "Output limits must be ordered."
      },
      {
        "left": "v_cm_min",
        "op": "<",
        "right": "v_cm_max",
        "message": "Input common-mode limits must be ordered."
      },
      {
        "left": "v_reference",
        "op": ">=",
        "right": "v_cm_min",
        "message": "Reference is below the input common-mode range."
      },
      {
        "left": "v_reference",
        "op": "<=",
        "right": "v_cm_max",
        "message": "Reference is above the input common-mode range."
      },
      {
        "left": "v_initial",
        "op": ">=",
        "right": "v_out_min",
        "message": "Initial output is below the linear output range."
      },
      {
        "left": "v_initial",
        "op": "<=",
        "right": "v_out_max",
        "message": "Initial output is above the linear output range."
      },
      {
        "left": "v_initial-(v_in-v_reference)*duration/(r_input*c_feedback)",
        "op": ">=",
        "right": "v_out_min",
        "message": "Final output is below the linear output range."
      },
      {
        "left": "v_initial-(v_in-v_reference)*duration/(r_input*c_feedback)",
        "op": "<=",
        "right": "v_out_max",
        "message": "Final output is above the linear output range."
      }
    ],
    "example": {
      "inputs": {
        "r_input": 10000.0,
        "c_feedback": 1e-07,
        "v_in": 0.25,
        "v_reference": 0.0,
        "v_initial": 1.0,
        "duration": 0.002,
        "v_out_min": -10.0,
        "v_out_max": 10.0,
        "v_cm_min": -10.0,
        "v_cm_max": 10.0
      },
      "expected": {
        "output_slope": -250.0,
        "v_final": 0.5
      },
      "relative_tolerance": 1e-06
    }
  },
  {
    "id": "opamps.differentiator_ramp",
    "title": "Differentiator response to an input ramp",
    "category": "Operational amplifier stages",
    "level": "intermediate",
    "description": "Calculate the capacitor-input differentiator's output during the interior of a constant-slope input ramp.",
    "formula": "m = (Vend-Vstart)/T; Vo = Vref - Rf C m",
    "assumptions": [
      "Input capacitor C connects the voltage source to the inverting input; Rf connects output to inverting input; noninverting input is held at constant Vref.",
      "A linear input ramp is observed away from its endpoints after startup transients. Abrupt ideal corners or steps are not modeled.",
      "Ideal stable feedback and negligible bias/offset. Practical differentiators need bandwidth-limiting compensation; this is a local slope calculation, not a realizable all-frequency response or filter synthesis.",
      "Use only when the practical stage approximates ideal differentiation over the input's occupied bandwidth; output load, bandwidth and slew limits require separate device checks.",
      "Input-pin common-mode voltage equals Vref; source ramp voltage is not itself the op-amp pin voltage."
    ],
    "references": [
      {
        "title": "TI SBOA092B: Handbook of Operational Amplifier Applications, pp. 21-22, 38-39 and 61-62",
        "url": "https://www.ti.com/lit/an/sboa092b/sboa092b.pdf"
      }
    ],
    "inputs": [
      {
        "key": "r_feedback",
