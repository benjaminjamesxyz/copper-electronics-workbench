        "key": "slew_margin",
        "label": "Available versus theoretical slew margin",
        "unit": "1",
        "expression": "slew_available/required_slew"
      }
    ],
    "constraints": [
      {
        "left": "v_out_min",
        "op": "<",
        "right": "v_out_max",
        "message": "Output limits must be ordered."
      },
      {
        "left": "v_center-v_peak",
        "op": ">=",
        "right": "v_out_min",
        "message": "Negative sine peak is below the linear output range."
      },
      {
        "left": "v_center+v_peak",
        "op": "<=",
        "right": "v_out_max",
        "message": "Positive sine peak is above the linear output range."
      }
    ],
    "example": {
      "inputs": {
