[
  {
    "id": "opto.photodiode_quantum_conversion",
    "title": "Unity-gain photodiode photon conversion",
    "category": "Optical hardware",
    "level": "basic",
    "description": "Convert monochromatic optical power and external quantum efficiency to collected photocurrent, without amplifier or noise modeling.",
    "formula": "Eph=hc/lambda; photon_rate=P/Eph; R=eta*q*lambda/(hc); Iph=R*P",
    "assumptions": [
      "Monochromatic illumination, unity internal gain, and external quantum efficiency at the stated wavelength, bias and temperature.",
      "Quantum efficiency includes window, reflection and carrier-collection losses; it is not an independent fitted constant across all wavelengths.",
      "Photocurrent is a nonnegative magnitude of the generated reverse current, excluding dark current, loading, saturation and noise.",
      "Use measured linear operating range and material spectral response; this calculation does not enforce a device rating."
    ],
    "references": [
      {
        "title": "Hamamatsu Si photodiodes, sections 2-2 and 2-3, equation 2-3",
        "url": "https://www.hamamatsu.com/content/dam/hamamatsu-photonics/sites/documents/99_SALES_LIBRARY/ssd/si_pd_kspd9001e.pdf"
      },
      {
        "title": "Hamamatsu MPPC physics, section I equation 3 with gain M=1",
        "url": "https://hub.hamamatsu.com/us/en/technical-notes/mppc-sipms/physics-and-operation-of-the-MPPC-silicon-photomultiplier.html"
      }
    ],
    "inputs": [
      {
        "key": "wavelength",
        "label": "Vacuum wavelength",
        "unit": "m",
        "default": 8.5e-07,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "quantum_efficiency",
        "label": "External quantum efficiency",
        "unit": "1",
        "default": 0.75,
        "min": 0,
        "max": 1
      },
      {
        "key": "optical_power",
        "label": "Incident monochromatic optical power",
        "unit": "W",
        "default": 2e-05,
        "min": 0
      }
    ],
    "outputs": [
      {
        "key": "photon_energy",
        "label": "Energy per photon",
        "unit": "J",
        "expression": "6.62607015e-34*299792458/wavelength"
      },
      {
        "key": "photon_rate",
        "label": "Incident photon rate",
        "unit": "1/s",
        "expression": "optical_power/photon_energy"
      },
      {
        "key": "responsivity",
        "label": "Spectral responsivity",
        "unit": "A/W",
        "expression": "quantum_efficiency*(1.602176634e-19/(6.62607015e-34*299792458))*wavelength"
      },
      {
        "key": "photocurrent",
        "label": "Generated photocurrent magnitude",
        "unit": "A",
        "expression": "responsivity*optical_power"
      }
    ],
    "constraints": [],
    "example": {
      "inputs": {
        "wavelength": 8.5e-07,
        "quantum_efficiency": 0.75,
        "optical_power": 2e-05
      },
      "expected": {
        "photon_energy": 2.3369951260575634e-19,
        "photon_rate": 85579981648226.06,
        "responsivity": 0.5141784260060123,
        "photocurrent": 1.0283568520120244e-05
      },
      "relative_tolerance": 1e-06
    }
  },
  {
    "id": "opto.lambertian_target_irradiance",
    "title": "Lambertian source target irradiance",
    "category": "Optical hardware",
    "level": "basic",
    "description": "Estimate irradiance at a target point from hemisphere flux, source orientation and receiving-plane tilt.",
    "formula": "I0=Phi/pi; I(theta)=I0*cos(theta); E=I(theta)*cos(phi)/r^2",
    "assumptions": [
      "Ideal Lambertian emitter radiates the entered total optical flux into one unobstructed hemisphere.",
      "Point-source/far-field approximation: source dimensions must be much smaller than source-to-target distance.",
      "Angles in radians are measured from source normal and the target normal pointing toward the source; both are within the forward hemisphere.",
      "Target irradiance is a local value, not total intercepted power for an extended surface. No lens, reflection, absorption or photometric lux conversion."
    ],
    "references": [
      {
        "title": "Newport Laws of Radiation, Lambert law",
        "url": "https://www.newport.com/t/laws-of-radiation/"
      },
      {
        "title": "Newport Oriel Spectral Irradiance, units and distance scaling pages 2 and 5",
        "url": "https://www.newport.com/medias/sys_master/images/images/hfb/hdf/8797196451870/Light-Sources.pdf"
      }
    ],
    "inputs": [
      {
        "key": "radiant_flux",
        "label": "Forward hemisphere radiant flux",
        "unit": "W",
        "default": 0.1,
        "min": 0
      },
      {
        "key": "distance",
        "label": "Source to target distance",
        "unit": "m",
        "default": 0.2,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "emission_angle",
        "label": "Source normal to outgoing ray angle",
        "unit": "rad",
        "default": 0.5235987755982989,
        "min": 0
      },
      {
        "key": "incidence_angle",
        "label": "Target normal to source direction angle",
        "unit": "rad",
        "default": 0.7853981633974483,
        "min": 0
      }
    ],
    "outputs": [
      {
        "key": "axial_intensity",
        "label": "On-axis radiant intensity",
        "unit": "W/sr",
        "expression": "radiant_flux/pi"
      },
      {
        "key": "directional_intensity",
        "label": "Radiant intensity toward target",
        "unit": "W/sr",
        "expression": "axial_intensity*cos(emission_angle)"
      },
      {
        "key": "target_irradiance",
        "label": "Local target irradiance",
        "unit": "W/m^2",
        "expression": "directional_intensity*cos(incidence_angle)/distance/distance"
      }
    ],
    "constraints": [
      {
        "left": "emission_angle",
        "op": "<=",
        "right": "pi/2",
        "message": "Emission angle must lie in the forward hemisphere."
      },
      {
        "left": "incidence_angle",
        "op": "<=",
        "right": "pi/2",
        "message": "Receiving surface must face the source."
      }
    ],
    "example": {
      "inputs": {
        "radiant_flux": 0.1,
        "distance": 0.2,
        "emission_angle": 0.5235987755982989,
        "incidence_angle": 0.7853981633974483
      },
      "expected": {
        "axial_intensity": 0.03183098861837907,
        "directional_intensity": 0.0275664447710896,
        "target_irradiance": 0.4873105007710476
      },
      "relative_tolerance": 1e-06
    }
  },
  {
    "id": "opto.layer_absorption_capture",
    "title": "Inactive and active optical layer absorption",
    "category": "Optical hardware",
    "level": "intermediate",
    "description": "Partition incident optical power between a noncollecting entrance layer, a useful absorbing layer and transmitted light.",
    "formula": "Pd=P0*(1-exp(-alpha_d*d)); Fa=exp(-alpha_d*d)*(1-exp(-alpha_a*t)); Pa=P0*Fa; Pt=P0*exp(-alpha_d*d-alpha_a*t)",
    "assumptions": [
      "Homogeneous independent absorption coefficients at one wavelength; normal incidence, no scattering, fluorescence or optical gain.",
      "Incident power is defined immediately inside the entrance surface. Ignore interface reflections and coherent thin-film interference.",
      "Inactive layer absorption is lost; active absorption is optical capture only, not collected photocurrent or quantum efficiency.",
      "The exponential single-pass model applies without back-reflection or optical saturation; coefficients must come from material data at operating conditions."
    ],
    "references": [
      {
        "title": "Hamamatsu MPPC physics, section I equation 1 and absorption-depth discussion",
        "url": "https://hub.hamamatsu.com/us/en/technical-notes/mppc-sipms/physics-and-operation-of-the-MPPC-silicon-photomultiplier.html"
      }
    ],
    "inputs": [
      {
        "key": "incident_power",
        "label": "Power just inside entrance surface",
        "unit": "W",
        "default": 0.002,
        "min": 0
      },
      {
        "key": "dead_absorption",
        "label": "Inactive-layer absorption coefficient",
        "unit": "1/m",
        "default": 200000.0,
        "min": 0
      },
      {
        "key": "dead_thickness",
        "label": "Inactive-layer thickness",
        "unit": "m",
        "default": 1e-06,
        "min": 0
      },
      {
        "key": "active_absorption",
        "label": "Active-layer absorption coefficient",
        "unit": "1/m",
        "default": 100000.0,
        "min": 0
      },
      {
        "key": "active_thickness",
        "label": "Active-layer thickness",
        "unit": "m",
        "default": 1e-05,
        "min": 0
      }
    ],
    "outputs": [
      {
        "key": "dead_absorbed_power",
        "label": "Power lost in inactive layer",
        "unit": "W",
        "expression": "incident_power*(-expm1(-dead_absorption*dead_thickness))"
      },
      {
        "key": "active_capture_fraction",
        "label": "Fraction captured in active layer",
        "unit": "1",
        "expression": "exp(-dead_absorption*dead_thickness)*(-expm1(-active_absorption*active_thickness))"
      },
      {
        "key": "active_absorbed_power",
        "label": "Power captured in active layer",
        "unit": "W",
        "expression": "incident_power*active_capture_fraction"
      },
      {
        "key": "transmitted_power",
        "label": "Power transmitted through both layers",
        "unit": "W",
        "expression": "incident_power*exp(-dead_absorption*dead_thickness-active_absorption*active_thickness)"
      }
    ],
    "constraints": [],
    "example": {
      "inputs": {
        "incident_power": 0.002,
        "dead_absorption": 200000.0,
        "dead_thickness": 1e-06,
        "active_absorption": 100000.0,
        "active_thickness": 1e-05
      },
      "expected": {
        "dead_absorbed_power": 0.0003625384938440363,
        "active_capture_fraction": 0.5175365411657797,
        "active_absorbed_power": 0.0010350730823315596,
        "transmitted_power": 0.0006023884238244042
      },
      "relative_tolerance": 1e-06
    }
  }
]
