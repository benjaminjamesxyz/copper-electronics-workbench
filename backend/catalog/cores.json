[
  {
    "id": "cores.single_layer_air_solenoid",
    "title": "Single-layer air solenoid geometry",
    "category": "Winding and magnetic design",
    "level": "basic",
    "description": "Estimate the low-frequency inductance of a finite-length, closely spaced cylindrical air winding.",
    "formula": "L = (1e-6/0.0254) r^2 N^2/(9r+10l); pitch=l/N",
    "assumptions": [
      "Wheeler empirical current-sheet approximation; all supplied dimensions are metres, not inches.",
      "Nonmagnetic former, single uniform layer, no nearby conducting or magnetic body; low-frequency inductance only, well below self resonance.",
      "Radius is to wire centres. Length is the axial current-sheet span N times pitch. End leads are omitted.",
      "Length >= radius and pitch <= radius/5 are conservative geometry screens, not a certified accuracy guarantee. Actual winding shape requires measurement."
    ],
    "references": [
      {
        "title": "University of Georgia: Inductance Meter for Small Inductances, Motivation",
        "url": "https://photonics.engr.uga.edu/inductor_meter/index.html"
      },
      {
        "title": "Jim Lux: Wheeler Formulas, explicit inch and microhenry units",
        "url": "https://www.pe2bz.philpem.me.uk/Power/-%20-%20Power-Design%20-%20-/HighVoltage/wheeler.htm"
      }
    ],
    "inputs": [
      {
        "key": "radius",
        "label": "Mean winding radius",
        "unit": "m",
        "default": 0.01,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "length",
        "label": "Axial winding span",
        "unit": "m",
        "default": 0.03,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "turns",
        "label": "Complete turns",
        "unit": "turn",
        "default": 20,
        "min": 1
      },
      {
        "key": "wire_diameter",
        "label": "Insulated wire diameter",
        "unit": "m",
        "default": 0.001,
        "min": 0,
        "exclusive_min": true
      }
    ],
    "outputs": [
      {
        "key": "inductance",
        "label": "Estimated inductance",
        "unit": "H",
        "expression": "(1e-6/0.0254)*radius*turns^2/(9+10*length/radius)"
      },
      {
        "key": "turn_pitch",
        "label": "Axial turn pitch",
        "unit": "m",
        "expression": "length/turns"
      }
    ],
    "constraints": [
      {
        "left": "turns",
        "op": "==",
        "right": "floor(turns)",
        "message": "Turns must be an integer."
      },
      {
        "left": "length",
        "op": ">=",
        "right": "radius",
        "message": "Use a winding at least one mean radius long."
      },
      {
        "left": "length/turns",
        "op": ">=",
        "right": "wire_diameter",
        "message": "Insulated turns must not overlap."
      },
      {
        "left": "length/turns",
        "op": "<=",
        "right": "radius/5",
        "message": "Current-sheet screening requires pitch no greater than radius/5."
      }
    ],
    "example": {
      "inputs": {
        "radius": 0.01,
        "length": 0.03,
        "turns": 20,
        "wire_diameter": 0.001
      },
      "expected": {
        "inductance": 4.037956793862305e-06,
        "turn_pitch": 0.0015
      },
      "relative_tolerance": 1e-09
    }
  },
  {
    "id": "cores.square_planar_spiral",
    "title": "Square planar spiral current-sheet inductance",
    "category": "Winding and magnetic design",
    "level": "intermediate",
    "description": "Size an isolated square spiral from its trace width, spacing, turns and outside dimension.",
    "formula": "di=do-2[Nw+(N-1)s]; davg=(do+di)/2; fill=(do-di)/(do+di); L=mu0 N^2 davg*1.27/2*[ln(2.07/fill)+0.18fill+0.13fill^2]",
    "assumptions": [
      "Mohan square current-sheet fit, DC/quasistatic inductance; not a self-resonant frequency or Q prediction.",
      "Uniform thin conductor on a nonmagnetic substrate; no nearby ground plane, shield or magnetic core. Thickness, underpass and terminal parasitics are omitted.",
      "Source reports at most 8% error for spacing <= 3 widths in its studied integrated-spiral population; typical errors are smaller. This is not a PCB-wide guaranteed tolerance.",
      "Integer complete turns are used. Inner-side geometry follows the ideal nested-turn convention; terminal routing is excluded."
    ],
    "references": [
      {
        "title": "Mohan et al., 1999: current-sheet equation (2), Table II",
        "url": "https://web.stanford.edu/~boyd/papers/pdf/inductance_expressions.pdf"
      }
    ],
    "inputs": [
      {
        "key": "outer_side",
        "label": "Outer square side",
        "unit": "m",
        "default": 0.0003,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "turns",
        "label": "Complete turns",
        "unit": "turn",
        "default": 4,
        "min": 1
      },
      {
        "key": "trace_width",
        "label": "Trace width",
        "unit": "m",
        "default": 1e-05,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "spacing",
        "label": "Edge-to-edge spacing",
        "unit": "m",
        "default": 1e-05,
        "min": 0,
        "exclusive_min": true
      }
    ],
    "outputs": [
      {
        "key": "inner_side",
        "label": "Inner clear side",
        "unit": "m",
        "expression": "outer_side-2*(turns*trace_width+(turns-1)*spacing)"
      },
      {
        "key": "average_side",
        "label": "Average square side",
        "unit": "m",
        "expression": "(outer_side+inner_side)/2"
      },
      {
        "key": "fill_ratio",
        "label": "Radial fill ratio",
        "unit": "1",
        "expression": "(turns*trace_width+(turns-1)*spacing)/average_side"
      },
      {
        "key": "inductance",
        "label": "Estimated inductance",
        "unit": "H",
        "expression": "4*pi*1e-7*turns^2*average_side*1.27/2*(ln(2.07/fill_ratio)+0.18*fill_ratio+0.13*fill_ratio^2)"
      }
    ],
    "constraints": [
      {
        "left": "turns",
        "op": "==",
        "right": "floor(turns)",
        "message": "Turns must be an integer."
      },
      {
        "left": "outer_side",
        "op": ">",
        "right": "2*(turns*trace_width+(turns-1)*spacing)",
        "message": "The spiral must retain a positive central opening."
      },
      {
        "left": "spacing",
        "op": "<=",
        "right": "3*trace_width",
        "message": "Use spacing no greater than three trace widths for this fit."
      }
    ],
    "example": {
      "inputs": {
        "outer_side": 0.0003,
        "turns": 4,
        "trace_width": 1e-05,
        "spacing": 1e-05
      },
      "expected": {
        "inner_side": 0.00015999999999999996,
        "average_side": 0.00022999999999999995,
        "fill_ratio": 0.3043478260869566,
        "inductance": 5.825908169108072e-09
      },
      "relative_tolerance": 1e-09
    }
  },
  {
    "id": "cores.bobbin_layer_fit",
    "title": "Insulated round-wire bobbin layer fit",
    "category": "Winding and magnetic design",
    "level": "basic",
    "description": "Check discrete turns and radial build of a square-packed winding with end margins and interlayer tape.",
    "formula": "q=floor((W-2m)/do); layers=ceil(N/q); build=layers*do+(layers-1)t; fill=N*pi*dc^2/[4(W-2m)H]",
    "assumptions": [
      "Ordered square-packed circular wire with uniform finished diameter; no orthocyclic nesting, random winding, litz bundle or compression.",
      "Window width and height are already net of bobbin wall and base insulation. End margin is reserved independently at each flange.",
      "Tape lies only between occupied layers. Last partial layer consumes a full radial layer. Crossovers and leads require additional clearance outside this model.",
      "Geometric fit does not establish creepage, dielectric withstand, thermal rating or safety compliance. Use maximum finished wire diameter and minimum available dimensions."
    ],
    "references": [
      {
        "title": "TI SLUP126: Window Utilization and winding design Step 14",
        "url": "https://www.ti.com/lit/ml/slup126/slup126.pdf"
      }
    ],
    "inputs": [
      {
        "key": "window_width",
        "label": "Net bobbin width",
        "unit": "m",
        "default": 0.02,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "window_height",
        "label": "Available radial height",
        "unit": "m",
        "default": 0.004,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "end_margin",
        "label": "Margin at each flange",
        "unit": "m",
        "default": 0.001,
        "min": 0
      },
      {
        "key": "wire_diameter",
        "label": "Finished wire diameter",
        "unit": "m",
        "default": 0.0006,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "copper_diameter",
        "label": "Bare copper diameter",
        "unit": "m",
        "default": 0.0005,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "tape_thickness",
        "label": "Interlayer tape thickness",
        "unit": "m",
        "default": 0.0001,
        "min": 0
      },
      {
        "key": "turns",
        "label": "Required complete turns",
        "unit": "turn",
        "default": 100,
        "min": 1
      }
    ],
    "outputs": [
      {
        "key": "turns_per_layer",
        "label": "Complete turns per layer",
        "unit": "turn",
        "expression": "floor((window_width-2*end_margin)/wire_diameter)"
      },
      {
        "key": "layers_required",
        "label": "Occupied layers",
        "unit": "layer",
        "expression": "ceil(turns/turns_per_layer)"
      },
      {
        "key": "radial_build",
        "label": "Winding radial build",
        "unit": "m",
        "expression": "layers_required*wire_diameter+(layers_required-1)*tape_thickness"
      },
      {
        "key": "height_margin",
        "label": "Remaining radial clearance",
        "unit": "m",
        "expression": "window_height-radial_build"
      },
      {
        "key": "copper_fill",
        "label": "Copper fraction of usable window",
        "unit": "1",
        "expression": "turns*pi*copper_diameter^2/(4*(window_width-2*end_margin)*window_height)"
      }
    ],
    "constraints": [
      {
        "left": "turns",
        "op": "==",
        "right": "floor(turns)",
        "message": "Turns must be an integer."
      },
      {
        "left": "window_width-2*end_margin",
        "op": ">=",
        "right": "wire_diameter",
        "message": "At least one finished wire must fit between margins."
      },
      {
        "left": "copper_diameter",
        "op": "<=",
        "right": "wire_diameter",
        "message": "Copper diameter cannot exceed finished diameter."
      },
      {
        "left": "ceil(turns/floor((window_width-2*end_margin)/wire_diameter))*wire_diameter+(ceil(turns/floor((window_width-2*end_margin)/wire_diameter))-1)*tape_thickness",
        "op": "<=",
        "right": "window_height",
        "message": "Requested winding does not fit the available radial height."
      }
    ],
    "example": {
      "inputs": {
        "window_width": 0.02,
        "window_height": 0.004,
        "end_margin": 0.001,
        "wire_diameter": 0.0006,
        "copper_diameter": 0.0005,
        "tape_thickness": 0.0001,
        "turns": 100
      },
      "expected": {
        "turns_per_layer": 30,
        "layers_required": 4,
        "radial_build": 0.0026999999999999997,
        "height_margin": 0.0013000000000000004,
        "copper_fill": 0.2727076956241139
      },
      "relative_tolerance": 1e-09
    }
  },
  {
    "id": "cores.sinusoidal_steinmetz_loss",
    "title": "Calibrated sinusoidal core-loss scaling",
    "category": "Winding and magnetic design",
    "level": "intermediate",
    "description": "Estimate total volumetric core loss within a supplied material fit rectangle, using a measured reference rather than unit-sensitive k.",
    "formula": "pv=pref*(f/fref)^alpha*(Bpk/Bref)^beta; P=pv*Ve; Ecycle=P/f",
    "assumptions": [
      "Empirical Steinmetz scaling for sinusoidal flux, zero DC bias, and the same fixed temperature/material as calibration.",
      "Reference loss density includes all measured core-loss mechanisms. Do not add classical eddy loss to this total.",
      "Frequency and flux bounds must come from the actual fitted dataset and remain below saturation; the tool cannot authenticate calibration data.",
      "Defaults are an illustrative hypothetical calibration, not a claim about a named ferrite. No PWM, minor-loop, biased or temperature-extrapolated prediction."
    ],
    "references": [
      {
        "title": "Sullivan et al., 2010: section II, sinusoidal Steinmetz fit and limits",
        "url": "https://www.wcmagnetics.com/wp-content/uploads/2015/03/Core-Loss-Prediction-Square-Wave-Sullivan.pdf"
      },
      {
        "title": "MIT 6.685, Kirtley: sections 3.4 and 4",
        "url": "https://ocw.mit.edu/courses/6-685-electric-machines-fall-2013/73ce73e3a02b085d00df37882e7636fe_MIT6_685F13_chapter3.pdf"
      }
    ],
    "inputs": [
      {
        "key": "frequency",
        "label": "Operating frequency",
        "unit": "Hz",
        "default": 150000,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "flux_peak",
        "label": "Peak sinusoidal flux density",
        "unit": "T",
        "default": 0.08,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "reference_frequency",
        "label": "Calibration reference frequency",
        "unit": "Hz",
        "default": 100000,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "reference_flux_peak",
        "label": "Calibration reference peak flux",
        "unit": "T",
        "default": 0.1,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "reference_loss_density",
        "label": "Measured reference loss density",
        "unit": "W/m^3",
        "default": 200000,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "frequency_exponent",
        "label": "Fitted frequency exponent",
        "unit": "1",
        "default": 1.5,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "flux_exponent",
        "label": "Fitted flux exponent",
        "unit": "1",
        "default": 2.5,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "core_volume",
        "label": "Effective magnetic volume",
        "unit": "m^3",
        "default": 1e-05,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "fit_frequency_min",
        "label": "Lowest calibrated frequency",
        "unit": "Hz",
        "default": 50000,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "fit_frequency_max",
        "label": "Highest calibrated frequency",
        "unit": "Hz",
        "default": 200000,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "fit_flux_min",
        "label": "Lowest calibrated peak flux",
        "unit": "T",
        "default": 0.05,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "fit_flux_max",
        "label": "Highest calibrated peak flux",
        "unit": "T",
        "default": 0.15,
        "min": 0,
        "exclusive_min": true
      }
    ],
    "outputs": [
      {
        "key": "loss_density",
        "label": "Estimated total core-loss density",
        "unit": "W/m^3",
        "expression": "reference_loss_density*(frequency/reference_frequency)^frequency_exponent*(flux_peak/reference_flux_peak)^flux_exponent"
      },
      {
        "key": "core_loss",
        "label": "Estimated core heat",
        "unit": "W",
        "expression": "loss_density*core_volume"
      },
      {
        "key": "energy_per_cycle",
        "label": "Core loss per cycle",
        "unit": "J",
        "expression": "core_loss/frequency"
      }
    ],
    "constraints": [
      {
        "left": "fit_frequency_max",
        "op": ">=",
        "right": "fit_frequency_min",
        "message": "Frequency calibration limits must be ordered."
      },
      {
        "left": "fit_flux_max",
        "op": ">=",
        "right": "fit_flux_min",
        "message": "Flux calibration limits must be ordered."
      },
      {
        "left": "frequency",
        "op": ">=",
        "right": "fit_frequency_min",
        "message": "Value lies below its calibrated fit range."
      },
      {
        "left": "reference_frequency",
        "op": ">=",
        "right": "fit_frequency_min",
        "message": "Value lies below its calibrated fit range."
      },
      {
        "left": "flux_peak",
        "op": ">=",
        "right": "fit_flux_min",
        "message": "Value lies below its calibrated fit range."
      },
      {
        "left": "reference_flux_peak",
        "op": ">=",
        "right": "fit_flux_min",
        "message": "Value lies below its calibrated fit range."
      },
      {
        "left": "frequency",
        "op": "<=",
        "right": "fit_frequency_max",
        "message": "Value lies above its calibrated fit range."
      },
      {
        "left": "reference_frequency",
        "op": "<=",
        "right": "fit_frequency_max",
        "message": "Value lies above its calibrated fit range."
      },
      {
        "left": "flux_peak",
        "op": "<=",
        "right": "fit_flux_max",
        "message": "Value lies above its calibrated fit range."
      },
      {
        "left": "reference_flux_peak",
        "op": "<=",
        "right": "fit_flux_max",
        "message": "Value lies above its calibrated fit range."
      }
    ],
    "example": {
      "inputs": {
        "frequency": 150000,
        "flux_peak": 0.08,
        "reference_frequency": 100000,
        "reference_flux_peak": 0.1,
        "reference_loss_density": 200000,
        "frequency_exponent": 1.5,
        "flux_exponent": 2.5,
        "core_volume": 1e-05,
        "fit_frequency_min": 50000,
        "fit_frequency_max": 200000,
        "fit_flux_min": 0.05,
        "fit_flux_max": 0.15
      },
      "expected": {
        "loss_density": 210325.46208198377,
        "core_loss": 2.103254620819838,
        "energy_per_cycle": 1.4021697472132253e-05
      },
      "relative_tolerance": 1e-09
    }
  }
]
