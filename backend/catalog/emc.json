[
{
  "id": "emc.thin_slot_shielding",
  "title": "Thin-slot shield leakage estimate",
  "category": "EMC design",
  "level": "basic",
  "description": "Estimate the worst-orientation field leakage through one electrically small, thin rectangular slot. Engineering estimate, not enclosure compliance.",
  "formula": "lambda=c/f; SE=20 log10(lambda/(2L)); E_transmitted/E_incident=2L/lambda",
  "assumptions": [
    "One isolated slot in an otherwise highly conducting shield; L>w and L>=10t define the thin-slot geometry used here.",
    "L<=lambda/20 restricts operation to the manufacturer's electrically small design guideline.",
    "Worst polarization/orientation estimate; no cavity resonance, seams, multiple apertures, penetrations or near-field magnetic shielding.",
    "Estimate only, not a certified shielding effectiveness or EMC compliance result."
  ],
  "references": [
    {
      "title": "Laird technical note 154, Rule-of-Thumb for Calculating Aperture Size, page 1",
      "url": "http://cdn.lairdtech.com/home/brandworld/files/EMI%20Rule-of-Thumb%20for%20Calculating%20Aperture%20Size%20Technical%20Note%20Download.pdf"
    }
  ],
  "inputs": [
    {
      "key": "frequency",
      "label": "Interference frequency",
      "unit": "Hz",
      "default": 100000000,
      "min": 0,
      "exclusive_min": true
    },
    {
      "key": "slot_length",
      "label": "Longest slot dimension",
      "unit": "m",
      "default": 0.02,
      "min": 0,
      "exclusive_min": true
    },
    {
      "key": "slot_width",
      "label": "Slot width",
      "unit": "m",
      "default": 0.002,
      "min": 0,
      "exclusive_min": true
    },
    {
      "key": "shield_thickness",
      "label": "Shield thickness",
      "unit": "m",
      "default": 0.0005,
      "min": 0
    }
  ],
  "outputs": [
    {
      "key": "wavelength",
      "label": "Free-space wavelength",
      "unit": "m",
      "expression": "299792458/frequency"
    },
    {
      "key": "shielding_db",
      "label": "Slot shielding estimate",
      "unit": "dB",
      "expression": "20*log10(wavelength/(2*slot_length))"
    },
    {
      "key": "field_ratio",
      "label": "Transmitted-to-incident field ratio",
      "unit": "1",
      "expression": "2*slot_length/wavelength"
    }
  ],
  "constraints": [
    {
      "left": "slot_length",
      "op": ">",
      "right": "slot_width",
      "message": "The longest dimension must exceed the width; this is a slot, not a round aperture."
    },
    {
      "left": "slot_length",
      "op": ">=",
      "right": "10*shield_thickness",
      "message": "Thin-slot estimate requires length at least ten times shield thickness."
    },
    {
      "left": "slot_length*frequency/299792458",
      "op": "<=",
      "right": "0.05",
      "message": "Slot length must not exceed wavelength/20 for this screening model."
    }
  ],
  "example": {
    "inputs": {
      "frequency": 100000000,
      "slot_length": 0.02,
      "slot_width": 0.002,
      "shield_thickness": 0.0005
    },
    "expected": {
      "wavelength": 2.99792458,
      "shielding_db": 37.495214231999306,
      "field_ratio": 0.013342563807926084
    },
    "relative_tolerance": 1e-06
  }
},
{
  "id": "emc.rc_common_mode_conversion",
  "title": "RC input-filter common-mode conversion",
  "category": "EMC design",
  "level": "expert",
  "description": "Predict differential interference created by mismatched RC input legs, including the bridging differential capacitor. Engineering estimate, not immunity compliance.",
  "formula": "D=R2 C2-R1 C1; a=1-w^2 R1 R2[C1 C2+Cd(C1+C2)]; b=w[R1(C1+Cd)+R2(C2+Cd)]; |Vdiff/Vcm|=w|D|/hypot(a,b)",
  "assumptions": [
    "Both ideal source nodes carry the same sinusoidal RMS common-mode voltage relative to the capacitor return.",
    "R1 and R2 feed separate high-impedance receiver inputs; C1 and C2 shunt these nodes to the common return; Cd bridges the receiver nodes.",
    "Lumped linear ideal components; effective source resistances may be included in R1/R2. No receiver loading, rectification, capacitor voltage dependence or amplifier CMRR.",
    "Differential polarity is node one minus node two. Output voltage is a nonnegative RMS magnitude.",
    "Estimate only, not proof of RF immunity or EMC compliance."
  ],
  "references": [
    {
      "title": "Texas Instruments, Art Kay, Common mode and differential filter, 2022, pages 2-5",
      "url": "https://e2e.ti.com/cfs-file/__key/communityserver-discussions-components-files/73/common-mode-and-differential-filter.pdf"
    }
  ],
  "inputs": [
    {
      "key": "resistance_one",
      "label": "Input one series resistance",
      "unit": "ohm",
      "default": 1000,
      "min": 0,
      "exclusive_min": true
    },
    {
      "key": "resistance_two",
      "label": "Input two series resistance",
      "unit": "ohm",
      "default": 1000,
      "min": 0,
      "exclusive_min": true
    },
    {
      "key": "capacitance_one",
      "label": "Input one common-mode capacitance",
      "unit": "F",
      "default": 1.01e-08,
      "min": 0,
      "exclusive_min": true
    },
    {
      "key": "capacitance_two",
      "label": "Input two common-mode capacitance",
      "unit": "F",
      "default": 9.9e-09,
      "min": 0,
      "exclusive_min": true
    },
    {
      "key": "differential_capacitance",
      "label": "Bridging differential capacitance",
      "unit": "F",
      "default": 1e-07,
      "min": 0
    },
    {
      "key": "frequency",
      "label": "Common-mode interference frequency",
      "unit": "Hz",
      "default": 10000,
      "min": 0
    },
    {
      "key": "common_mode_rms",
      "label": "Common-mode interference RMS",
      "unit": "V",
      "default": 0.1,
      "min": 0
    }
  ],
  "outputs": [
    {
      "key": "mismatch_time",
      "label": "Signed RC mismatch R2C2 minus R1C1",
      "unit": "s",
      "expression": "resistance_two*capacitance_two-resistance_one*capacitance_one"
    },
    {
      "key": "conversion_gain",
      "label": "Common-to-differential magnitude gain",
      "unit": "1",
      "expression": "2*pi*frequency*abs(mismatch_time)/hypot(1-(2*pi*frequency)^2*resistance_one*resistance_two*(capacitance_one*capacitance_two+differential_capacitance*(capacitance_one+capacitance_two)),2*pi*frequency*(resistance_one*(capacitance_one+differential_capacitance)+resistance_two*(capacitance_two+differential_capacitance)))"
    },
    {
      "key": "differential_rms",
      "label": "Converted differential RMS voltage",
      "unit": "V",
      "expression": "common_mode_rms*conversion_gain"
    }
  ],
  "constraints": [],
  "example": {
    "inputs": {
      "resistance_one": 1000,
      "resistance_two": 1000,
      "capacitance_one": 1.01e-08,
      "capacitance_two": 9.9e-09,
      "differential_capacitance": 1e-07,
      "frequency": 10000,
      "common_mode_rms": 0.1
    },
    "expected": {
      "mismatch_time": -2e-07,
      "conversion_gain": 0.0008041073247070083,
      "differential_rms": 8.041073247070084e-05
    },
    "relative_tolerance": 1e-06
  }
}
]
