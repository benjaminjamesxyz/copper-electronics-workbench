[
  {
    "id": "bjt.saturated_switch_drive",
    "title": "Saturated BJT switch base-drive sizing",
    "category": "Bipolar transistor design",
    "level": "basic",
    "description": "Choose the maximum base resistor for a specified collector current and datasheet-supported forced beta, including driver series resistance and current capability.",
    "formula": "Ib=Ic/beta_forced; Rb_max=(Vdrive_min-Vbe_sat_max)/Ib-Rdriver; Prb=Ib^2 Rb_max",
    "assumptions": [
      "Low-side NPN with emitter grounded and no base-emitter shunt resistor.",
      "Use a forced beta tied to a guaranteed Vce(sat) specification at the intended collector current and temperature, not typical forward-active hFE.",
      "Driver voltage is its guaranteed minimum Thevenin source voltage; series resistance is modeled separately.",
      "Choose a real resistor no larger than the calculated limit, then check maximum-drive current, tolerances, turn-off storage time and driver ratings separately."
    ],
    "references": [
      {
        "title": "onsemi AND9129/D: Understanding a Digital Transistor Datasheet, saturation test conditions and drive-current equations",
        "url": "https://www.onsemi.com/download/application-notes/pdf/and9129-d.pdf"
      },
      {
        "title": "onsemi TND6093/D: Low VCE(sat) BJTs in Automotive Applications, base-drive capability",
        "url": "https://www.onsemi.com/download/white-papers/pdf/tnd6093-d.pdf"
      }
    ],
    "inputs": [
      {
        "key": "i_collector",
        "label": "Required on-state collector current",
        "unit": "A",
        "default": 0.1,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "beta_forced",
        "label": "Datasheet-supported forced beta",
        "unit": "1",
        "default": 10,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "v_drive_min",
        "label": "Minimum driver source voltage",
        "unit": "V",
        "default": 3.3,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "vbe_sat_max",
        "label": "Maximum on-state base-emitter voltage",
        "unit": "V",
        "default": 0.9,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "r_driver",
        "label": "Driver series resistance",
        "unit": "ohm",
        "default": 20,
        "min": 0
      },
      {
        "key": "i_driver_max",
        "label": "Available driver source current",
        "unit": "A",
        "default": 0.02,
        "min": 0,
        "exclusive_min": true
      }
    ],
    "outputs": [
      {
        "key": "i_base_required",
        "label": "Required base current",
        "unit": "A",
        "expression": "i_collector/beta_forced"
      },
      {
        "key": "r_base_max",
        "label": "Maximum external base resistance",
        "unit": "ohm",
        "expression": "(v_drive_min-vbe_sat_max)/i_base_required-r_driver"
      },
      {
        "key": "p_base_resistor",
        "label": "External resistor dissipation at minimum drive",
        "unit": "W",
        "expression": "i_base_required^2*r_base_max"
      }
    ],
    "constraints": [
      {
        "left": "v_drive_min-vbe_sat_max",
        "op": ">",
        "right": "i_collector*r_driver/beta_forced",
        "message": "Driver must have enough voltage headroom for a positive external resistor."
      },
      {
        "left": "i_collector/beta_forced",
        "op": "<=",
        "right": "i_driver_max",
        "message": "Required base current exceeds the driver source-current capability."
      }
    ],
    "example": {
      "inputs": {
        "i_collector": 0.1,
        "beta_forced": 10,
        "v_drive_min": 3.3,
        "vbe_sat_max": 0.9,
        "r_driver": 20,
        "i_driver_max": 0.02
      },
      "expected": {
        "i_base_required": 0.01,
        "r_base_max": 220,
        "p_base_resistor": 0.022
      },
      "relative_tolerance": 1e-06
    }
  },
  {
    "id": "bjt.early_output_resistance",
    "title": "Early-effect incremental output resistance",
    "category": "Bipolar transistor design",
    "level": "expert",
    "description": "Estimate intrinsic collector output resistance from the affine Early-effect model, retaining operating Vce instead of assuming it negligible.",
    "formula": "Ic=I0(1+Vce/VA); ro=(VA+Vce)/Ic; go=Ic/(VA+Vce); ro_approx=VA/Ic",
    "assumptions": [
      "Forward-active idealized NPN at constant base-emitter voltage and junction temperature.",
      "VA is the positive magnitude of the negative collector-voltage-axis extrapolation; Ic is the measured current at the supplied Vce, not its zero-Vce extrapolation.",
      "Affine Early model excludes breakdown, high injection and collector resistance; ro is differential resistance, not Vce/Ic.",
      "Actual device voltage/current limits and the range over which output curves are approximately straight require datasheet or measurement confirmation."
    ],
    "references": [
      {
        "title": "MIT 6.101 Lecture 3, slide 21: Early voltage; slide 42: usual VA/Ic approximation",
        "url": "https://web.mit.edu/6.101/www/s2019/handouts/L03_4.pdf"
      }
    ],
    "inputs": [
      {
        "key": "v_early",
        "label": "Positive Early-voltage magnitude",
        "unit": "V",
        "default": 100,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "v_ce",
        "label": "Operating collector-emitter voltage",
        "unit": "V",
        "default": 5,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "v_be",
        "label": "Operating base-emitter voltage",
        "unit": "V",
        "default": 0.7,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "i_collector",
        "label": "Collector current at operating voltage",
        "unit": "A",
        "default": 0.001,
        "min": 0,
        "exclusive_min": true
      }
    ],
    "outputs": [
      {
        "key": "r_output",
        "label": "Affine-model intrinsic output resistance",
        "unit": "ohm",
        "expression": "(v_early+v_ce)/i_collector"
      },
      {
        "key": "g_output",
        "label": "Intrinsic output conductance",
        "unit": "S",
        "expression": "1/r_output"
      },
      {
        "key": "r_output_approx",
        "label": "VA much greater than Vce approximation",
        "unit": "ohm",
        "expression": "v_early/i_collector"
      },
      {
        "key": "approximation_relative_error",
        "label": "Fractional underestimate of the approximation",
        "unit": "1",
        "expression": "v_ce/(v_early+v_ce)"
      }
    ],
    "constraints": [
      {
        "left": "v_ce",
        "op": ">",
        "right": "v_be",
        "message": "Collector-base junction must be reverse biased for this forward-active model."
      }
    ],
    "example": {
      "inputs": {
        "v_early": 100,
        "v_ce": 5,
        "v_be": 0.7,
        "i_collector": 0.001
      },
      "expected": {
        "r_output": 105000,
        "g_output": 9.523809523809523e-06,
        "r_output_approx": 100000,
        "approximation_relative_error": 0.047619047619047616
      },
      "relative_tolerance": 1e-06
    }
  },
  {
    "id": "bjt.differential_pair_steering",
    "title": "Matched BJT differential-pair current steering",
    "category": "Bipolar transistor design",
    "level": "expert",
    "description": "Predict large-signal collector-current division in a matched discrete differential pair, including finite-beta conversion of emitter tail current.",
    "formula": "VT=kT/q; alpha=beta/(beta+1); x=Vdiff/VT; Ic1=alpha Itail exp(x)/(1+exp(x)); Ic2=alpha Itail/(1+exp(x)); d(Ic1-Ic2)/dVdiff=2 alpha Itail exp(x)/(VT(1+exp(x))^2); Idiff=alpha Itail expm1(x)/(1+exp(x))",
    "assumptions": [
      "Identical forward-active NPN devices at the same junction temperature; equal saturation currents and equal constant beta.",
      "Ideal tail source supplies the sum of emitter currents; collectors and tail source have sufficient compliance.",
      "No emitter degeneration; ignores Early effect, mismatch, leakage, high injection and source resistance.",
      "Vdiff=Vbase1-Vbase2; input thermal-voltage ratio is restricted to magnitude at most 40 to keep exponentials bounded and avoid claiming leakage-free extreme steering.",
      "200-450 K model envelope is not a junction-temperature rating; this is large-signal static steering, not small-signal-only op-amp gain."
    ],
    "references": [
      {
        "title": "MIT 6.012 Lecture 19, slides 10-11: emitter-coupled-pair large-signal analysis with alpha_F",
        "url": "https://ocw.mit.edu/courses/6-012-microelectronic-devices-and-circuits-fall-2009/9932f87a7b5ec3d088d0e0836a05c622_MIT6_012F09_lec19.pdf"
      }
    ],
    "inputs": [
      {
        "key": "i_tail",
        "label": "Total emitter tail current",
        "unit": "A",
        "default": 0.002,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "beta",
        "label": "Matched DC current gain",
        "unit": "1",
        "default": 100,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "temperature",
        "label": "Matched junction temperature",
        "unit": "K",
        "default": 300,
        "min": 200,
        "max": 450
      },
      {
        "key": "v_differential",
        "label": "Base 1 minus base 2 voltage",
        "unit": "V",
        "default": 0.02
      }
    ],
    "outputs": [
      {
        "key": "v_thermal",
        "label": "Thermal voltage",
        "unit": "V",
        "expression": "1.380649e-23*temperature/1.602176634e-19"
      },
      {
        "key": "alpha",
        "label": "Collector-to-emitter current ratio",
        "unit": "1",
        "expression": "beta/(beta+1)"
      },
      {
        "key": "current_ratio",
        "label": "Collector current ratio Ic1/Ic2",
        "unit": "1",
        "expression": "exp(v_differential/v_thermal)"
      },
      {
        "key": "i_collector_one",
        "label": "Collector 1 current",
        "unit": "A",
        "expression": "alpha*i_tail*current_ratio/(1+current_ratio)"
      },
      {
        "key": "i_collector_two",
        "label": "Collector 2 current",
        "unit": "A",
        "expression": "alpha*i_tail/(1+current_ratio)"
      },
      {
        "key": "i_difference",
        "label": "Collector 1 minus collector 2 current",
        "unit": "A",
        "expression": "alpha*i_tail*expm1(v_differential/v_thermal)/(1+current_ratio)"
      },
      {
        "key": "g_differential",
        "label": "Local differential-current transconductance",
        "unit": "S",
        "expression": "2*alpha*i_tail*current_ratio/(v_thermal*(1+current_ratio)^2)"
      }
    ],
    "constraints": [
      {
        "left": "abs(v_differential)*1.602176634e-19/(1.380649e-23*temperature)",
        "op": "<=",
        "right": "40",
        "message": "Differential voltage must be within forty thermal voltages for the bounded ideal matched-pair model."
      }
    ],
    "example": {
      "inputs": {
        "i_tail": 0.002,
        "beta": 100,
        "temperature": 300,
        "v_differential": 0.02
      },
      "expected": {
        "v_thermal": 0.02585199978643553,
        "alpha": 0.9900990099009901,
        "current_ratio": 2.1676302961648406,
        "i_collector_one": 0.001355062560591518,
        "i_collector_two": 0.0006251354592104623,
        "i_difference": 0.0007299271013810556,
        "g_differential": 0.03309487233880996
      },
      "relative_tolerance": 1e-06
    }
  }
]
