        "label": "FHA tank gain 2 n Vo/Vi",
        "unit": "1",
        "expression": "1/hypot(1+(1-1/normalized_frequency^2)/inductance_ratio,quality_factor*(normalized_frequency-1/normalized_frequency))"
      },
