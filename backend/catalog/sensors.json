[
  {
    "id": "sensors.ntc_steinhart_hart",
    "title": "Steinhart–Hart NTC thermistor temperature",
    "category": "Sensor transduction",
    "level": "intermediate",
    "description": "Convert a calibrated nonlinear thermistor resistance to temperature and local resistance-to-temperature sensitivity.",
    "formula": "1/T = A+B ln(R/1 ohm)+C ln(R/1 ohm)^3; dT/dR = -T^2(B+3C ln(R/1 ohm)^2)/R",
    "assumptions": [
      "Coefficients use the numerical resistance in ohms and temperature in kelvin; do not reuse coefficients fitted with kilohms.",
      "Monotonic NTC coefficient family B>0 and C>=0; coefficients and fit interval must come from calibration of the actual sensor.",
      "Negligible measurement self-heating, lead resistance and leakage; static thermal equilibrium. This is not a constant-TCR model."
    ],
    "references": [
      {
        "title": "ILX Lightwave TNSTEIN-1, equation (1), 2005",
        "url": "https://api.p1.mks.com/medias/sys_master/images/images/hdb/hac/8797291479070/TN-STEIN-1-Thermistor-Constant-Conversions-Beta-to-Steinhart-Hart.pdf"
      }
    ],
    "inputs": [
      {
        "key": "resistance",
        "label": "Measured thermistor resistance",
        "unit": "ohm",
        "default": 10000,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "coefficient_a",
        "label": "Steinhart–Hart A",
        "unit": "1/K",
        "default": 0.001129148
      },
      {
        "key": "coefficient_b",
        "label": "Steinhart–Hart B",
        "unit": "1/K",
        "default": 0.000234125,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "coefficient_c",
        "label": "Steinhart–Hart C",
        "unit": "1/K",
        "default": 8.76741e-08,
        "min": 0
      },
      {
        "key": "fit_temperature_min",
        "label": "Calibrated minimum temperature",
        "unit": "K",
        "default": 233.15,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "fit_temperature_max",
        "label": "Calibrated maximum temperature",
        "unit": "K",
        "default": 398.15,
        "min": 0,
        "exclusive_min": true
      }
    ],
    "outputs": [
      {
        "key": "temperature_kelvin",
        "label": "Thermistor temperature",
        "unit": "K",
        "expression": "1/(coefficient_a+coefficient_b*ln(resistance)+coefficient_c*ln(resistance)^3)"
      },
      {
        "key": "temperature_celsius",
        "label": "Thermistor temperature",
        "unit": "degC",
        "expression": "temperature_kelvin-273.15"
      },
      {
        "key": "temperature_sensitivity",
        "label": "Local temperature sensitivity",
        "unit": "K/ohm",
        "expression": "-temperature_kelvin*(temperature_kelvin/resistance)*(coefficient_b+3*coefficient_c*ln(resistance)^2)"
      }
    ],
    "constraints": [
      {
        "left": "fit_temperature_max",
        "op": ">",
        "right": "fit_temperature_min",
        "message": "Calibration temperature interval must be ordered"
      },
      {
        "left": "coefficient_a+coefficient_b*ln(resistance)+coefficient_c*ln(resistance)^3",
        "op": ">=",
        "right": "1/fit_temperature_max",
        "message": "Resistance implies temperature above the calibrated interval or nonpositive inverse temperature"
      },
      {
        "left": "coefficient_a+coefficient_b*ln(resistance)+coefficient_c*ln(resistance)^3",
        "op": "<=",
        "right": "1/fit_temperature_min",
        "message": "Resistance implies temperature below the calibrated interval"
      }
    ],
    "example": {
      "inputs": {
        "resistance": 10000,
        "coefficient_a": 0.001129148,
        "coefficient_b": 0.000234125,
        "coefficient_c": 8.76741e-08,
        "fit_temperature_min": 233.15,
        "fit_temperature_max": 398.15
      },
      "expected": {
        "temperature_kelvin": 298.1496681766963,
        "temperature_celsius": 24.999668176696318,
        "temperature_sensitivity": -0.002279553664363643
      },
      "relative_tolerance": 1e-09
    }
  },
  {
    "id": "sensors.platinum_callendar_van_dusen",
    "title": "Platinum RTD nonlinear resistance response",
    "category": "Sensor transduction",
    "level": "intermediate",
    "description": "Predict platinum RTD resistance and sensitivity including the subzero quartic term.",
    "formula": "R=R0[1+A t+B t^2+C(u-100)u^3], u=min(t,0); A=3.9083e-3, B=-5.775e-7, C=-4.183e-12",
    "assumptions": [
      "Nominal IEC 60751 platinum coefficient family, not a calibration or a guarantee of sensor tolerance class.",
      "Temperature is explicitly degrees Celsius; reference resistance is at 0 degrees Celsius.",
      "Valid reference-function range is -200 to 850 degrees Celsius; a particular package may have a narrower rating.",
      "Neglect self-heating, lead resistance, hysteresis and strain. Linear-model error compares against R0(1+A t), not a separate calculator."
    ],
    "references": [
      {
        "title": "Texas Instruments SDAA150, section 1.2.2.1, equations 21 and 23–26",
        "url": "https://www.ti.com/document-viewer/lit/html/SDAA150/GUID-D7335C6E-A97D-4849-80CC-6781C31A787C.html"
      }
    ],
    "inputs": [
      {
        "key": "zero_resistance",
        "label": "Resistance at 0 degrees Celsius",
        "unit": "ohm",
        "default": 100,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "temperature_celsius",
        "label": "Sensor temperature",
        "unit": "degC",
        "default": -100,
        "min": -200,
        "max": 850
      }
    ],
    "outputs": [
      {
        "key": "resistance",
        "label": "RTD resistance",
        "unit": "ohm",
        "expression": "zero_resistance*(1+3.9083e-3*temperature_celsius-5.775e-7*temperature_celsius^2-4.183e-12*(min(temperature_celsius,0)-100)*min(temperature_celsius,0)^3)"
      },
      {
        "key": "resistance_sensitivity",
        "label": "Local resistance sensitivity",
        "unit": "ohm/K",
        "expression": "zero_resistance*(3.9083e-3-1.155e-6*temperature_celsius-4.183e-12*(4*min(temperature_celsius,0)-300)*min(temperature_celsius,0)^2)"
      },
      {
        "key": "linear_model_error",
        "label": "Resistance minus tangent model at zero",
        "unit": "ohm",
        "expression": "zero_resistance*(-5.775e-7*temperature_celsius^2-4.183e-12*(min(temperature_celsius,0)-100)*min(temperature_celsius,0)^3)"
      }
    ],
    "constraints": [],
    "example": {
      "inputs": {
        "zero_resistance": 100,
        "temperature_celsius": -100
      },
      "expected": {
        "resistance": 60.25584,
        "resistance_sensitivity": 0.4053081,
        "linear_model_error": -0.66116
      },
      "relative_tolerance": 1e-09
    }
  },
  {
    "id": "sensors.type_t_cold_junction_emf",
    "title": "Type-T thermocouple EMF with finite cold junction",
    "category": "Sensor transduction",
    "level": "expert",
    "description": "Predict terminal EMF from both junction temperatures using the nonlinear NIST Type-T positive-temperature polynomial.",
    "formula": "E(t)=1e-3 sum(c_i t^i) V; Vterminal=E(Th)-E(Tc); Shot=dE(Th)/dTh",
    "assumptions": [
      "This calculation implements the NIST 0 to 400 degrees Celsius polynomial branch for both junctions; negative-temperature operation is not supported.",
      "Copper is the positive Type-T leg and constantan the negative leg. Terminal voltage is copper minus constantan at an isothermal reference block.",
      "Use homogeneous wire and open-circuit measurement; no parasitic junction gradients, leakage, wire tolerance or calibration error included.",
      "Cold-junction correction occurs in EMF space, not by subtracting temperatures. Divided differences preserve near-equal junction signals."
    ],
    "references": [
      {
        "title": "NIST SRD 60, Type T reference function, 0 to 400 degrees Celsius",
        "url": "https://its90.nist.gov/downloadFiles/type_t.tab.txt"
      },
      {
        "title": "Texas Instruments SBAA274A, sections 1.1 and 1.3",
        "url": "https://www.ti.com/lit/an/sbaa274a/sbaa274a.pdf"
      }
    ],
    "inputs": [
      {
        "key": "hot_temperature",
        "label": "Measurement-junction temperature",
        "unit": "degC",
        "default": 100,
        "min": 0,
        "max": 400
      },
      {
        "key": "cold_temperature",
        "label": "Isothermal reference-block temperature",
        "unit": "degC",
        "default": 25,
        "min": 0,
        "max": 400
      }
    ],
    "outputs": [
      {
        "key": "hot_emf",
        "label": "Hot-junction EMF relative to zero Celsius",
        "unit": "V",
        "expression": "1e-3*hot_temperature*(0.038748106364+hot_temperature*(0.00003329222788+hot_temperature*(2.0618243404E-7+hot_temperature*(-2.1882256846E-9+hot_temperature*(1.0996880928E-11+hot_temperature*(-3.0815758772E-14+hot_temperature*(4.547913529E-17+hot_temperature*-2.7512901673E-20)))))))"
      },
      {
        "key": "cold_emf",
        "label": "Cold-junction EMF relative to zero Celsius",
        "unit": "V",
        "expression": "1e-3*cold_temperature*(0.038748106364+cold_temperature*(0.00003329222788+cold_temperature*(2.0618243404E-7+cold_temperature*(-2.1882256846E-9+cold_temperature*(1.0996880928E-11+cold_temperature*(-3.0815758772E-14+cold_temperature*(4.547913529E-17+cold_temperature*-2.7512901673E-20)))))))"
      },
      {
        "key": "terminal_emf",
        "label": "Copper-minus-constantan terminal EMF",
        "unit": "V",
        "expression": "1e-3*(hot_temperature-cold_temperature)*((0.038748106364)*(1)+(0.00003329222788)*(hot_temperature+cold_temperature)+(2.0618243404E-7)*(hot_temperature^2+hot_temperature*cold_temperature+cold_temperature^2)+(-2.1882256846E-9)*(hot_temperature^3+hot_temperature^2*cold_temperature+hot_temperature*cold_temperature^2+cold_temperature^3)+(1.0996880928E-11)*(hot_temperature^4+hot_temperature^3*cold_temperature+hot_temperature^2*cold_temperature^2+hot_temperature*cold_temperature^3+cold_temperature^4)+(-3.0815758772E-14)*(hot_temperature^5+hot_temperature^4*cold_temperature+hot_temperature^3*cold_temperature^2+hot_temperature^2*cold_temperature^3+hot_temperature*cold_temperature^4+cold_temperature^5)+(4.547913529E-17)*(hot_temperature^6+hot_temperature^5*cold_temperature+hot_temperature^4*cold_temperature^2+hot_temperature^3*cold_temperature^3+hot_temperature^2*cold_temperature^4+hot_temperature*cold_temperature^5+cold_temperature^6)+(-2.7512901673E-20)*(hot_temperature^7+hot_temperature^6*cold_temperature+hot_temperature^5*cold_temperature^2+hot_temperature^4*cold_temperature^3+hot_temperature^3*cold_temperature^4+hot_temperature^2*cold_temperature^5+hot_temperature*cold_temperature^6+cold_temperature^7))"
      },
      {
        "key": "hot_sensitivity",
        "label": "Hot-junction Seebeck sensitivity",
        "unit": "V/K",
        "expression": "1e-3*((1*(0.038748106364))*hot_temperature^0+(2*(0.00003329222788))*hot_temperature^1+(3*(2.0618243404E-7))*hot_temperature^2+(4*(-2.1882256846E-9))*hot_temperature^3+(5*(1.0996880928E-11))*hot_temperature^4+(6*(-3.0815758772E-14))*hot_temperature^5+(7*(4.547913529E-17))*hot_temperature^6+(8*(-2.7512901673E-20))*hot_temperature^7)"
      }
    ],
    "constraints": [],
    "example": {
      "inputs": {
        "hot_temperature": 100,
        "cold_temperature": 25
      },
      "expected": {
        "hot_emf": 0.00427851861580027,
        "cold_emf": 0.0009919772678200114,
        "terminal_emf": 0.003286541347980259,
        "hot_sensitivity": 4.67849607861716e-05
      },
      "relative_tolerance": 1e-09
    }
  }
]
