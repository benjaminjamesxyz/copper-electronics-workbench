[
  {
    "id": "oscillators.timer_555_astable",
    "title": "555 astable charge-discharge timing",
    "category": "Oscillator design",
    "level": "basic",
    "description": "Predict self-triggered 555 output timing from its separate charging and discharging paths.",
    "formula": "tH=ln(2)(RA+RB)C; tL=ln(2)RB C; T=tH+tL; f=1/T; D=tH/T",
    "assumptions": [
      "Standard astable: pins 2 and 6 share the timing capacitor; RA connects supply to pin 7; RB connects pin 7 to the capacitor.",
      "Ideal trigger/threshold levels are VCC/3 and 2VCC/3; discharge saturation, leakage, threshold errors and propagation delays are neglected.",
      "Use a properly decoupled 5–15 V bipolar 555 supply, reset high, and component/current ratings from the selected device. The bipolar-555 distortion guideline limits the nominal frequency to 100 kHz.",
      "Duty is the fraction of output-high time, not the discharge-transistor on-time. This topology cannot produce duty below 0.5 with positive RA."
    ],
    "references": [
      {
        "title": "Texas Instruments xx555 data sheet, SLFS022K, section 6.3.2, equations 1–4",
        "url": "https://www.ti.com/lit/ds/symlink/ne555.pdf"
      }
    ],
    "inputs": [
      {
        "key": "charge_resistance",
        "label": "Supply-to-discharge resistance RA",
        "unit": "ohm",
        "default": 1000,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "discharge_resistance",
        "label": "Discharge-to-capacitor resistance RB",
        "unit": "ohm",
        "default": 10000,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "timing_capacitance",
        "label": "Timing capacitance",
        "unit": "F",
        "default": 1e-07,
        "min": 0,
        "exclusive_min": true
      }
    ],
    "outputs": [
      {
        "key": "high_time",
        "label": "Output high interval",
        "unit": "s",
        "expression": "ln(2)*(charge_resistance+discharge_resistance)*timing_capacitance"
      },
      {
        "key": "low_time",
        "label": "Output low interval",
        "unit": "s",
        "expression": "ln(2)*discharge_resistance*timing_capacitance"
      },
      {
        "key": "period",
        "label": "Oscillation period",
        "unit": "s",
        "expression": "high_time+low_time"
      },
      {
        "key": "frequency",
        "label": "Oscillation frequency",
        "unit": "Hz",
        "expression": "1/period"
      },
      {
        "key": "high_duty",
        "label": "Output high duty fraction",
        "unit": "1",
        "expression": "(charge_resistance+discharge_resistance)/(charge_resistance+2*discharge_resistance)"
      }
    ],
    "constraints": [
      {
        "left": "ln(2)*(charge_resistance+2*discharge_resistance)*timing_capacitance",
        "op": ">=",
        "right": "1e-5",
        "message": "The bipolar 555 model requires nominal frequency no greater than 100 kHz."
      }
    ],
    "example": {
      "inputs": {
        "charge_resistance": 1000,
        "discharge_resistance": 10000,
        "timing_capacitance": 1e-07
      },
      "expected": {
        "high_time": 0.0007624618986159398,
        "low_time": 0.0006931471805599453,
        "period": 0.001455609079175885,
        "frequency": 686.997638518554,
        "high_duty": 0.5238095238095238
      },
      "relative_tolerance": 1e-09
    }
  },
  {
    "id": "oscillators.comparator_rc_oscillator",
    "title": "Three-resistor comparator RC oscillator",
    "category": "Oscillator design",
    "level": "intermediate",
    "description": "Design the unequal duty and switching thresholds of an autonomous comparator relaxation oscillator.",
    "formula": "G=1+RF/RU+RF/RL; VL=Vs(RF/RU)/G; VH=Vs(1+RF/RU)/G; tH=RT C ln(1+RL/RF); tL=RT C ln(1+RU/RF)",
    "assumptions": [
      "Comparator output switches ideally between ground and supply. RU joins supply to noninverting input, RL joins that input to ground, and RF joins output to that input.",
      "Output drives timing resistor RT; timing capacitor to ground drives the inverting input. Internal comparator hysteresis is neglected.",
      "Propagation delay and output resistance must be negligible compared with both half-cycle intervals and RT; input common-mode range must include both thresholds.",
      "Capacitor leakage, bias current, parasitic capacitance and output-loading effects are excluded. Values predict the settled cycle, not the first startup pulse."
    ],
    "references": [
      {
        "title": "Texas Instruments SNOA998A, Relaxation Oscillator Circuit, design steps 1–7",
        "url": "https://www.ti.com/lit/ab/snoa998a/snoa998a.pdf"
      }
    ],
    "inputs": [
      {
        "key": "supply_voltage",
        "label": "Ideal output-high and supply voltage",
        "unit": "V",
        "default": 5,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "upper_resistance",
        "label": "Threshold node to supply RU",
        "unit": "ohm",
        "default": 20000,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "lower_resistance",
        "label": "Threshold node to ground RL",
        "unit": "ohm",
        "default": 40000,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "feedback_resistance",
        "label": "Output to threshold node RF",
        "unit": "ohm",
        "default": 20000,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "timing_resistance",
        "label": "Output to capacitor RT",
        "unit": "ohm",
        "default": 10000,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "timing_capacitance",
        "label": "Timing capacitance",
        "unit": "F",
        "default": 1e-07,
        "min": 0,
        "exclusive_min": true
      }
    ],
    "outputs": [
      {
        "key": "upper_threshold",
        "label": "High-output switching threshold",
        "unit": "V",
        "expression": "supply_voltage*(1+feedback_resistance/upper_resistance)/(1+feedback_resistance/upper_resistance+feedback_resistance/lower_resistance)"
      },
      {
        "key": "lower_threshold",
        "label": "Low-output switching threshold",
        "unit": "V",
        "expression": "supply_voltage*(feedback_resistance/upper_resistance)/(1+feedback_resistance/upper_resistance+feedback_resistance/lower_resistance)"
      },
      {
        "key": "high_time",
        "label": "Output high interval",
        "unit": "s",
        "expression": "timing_resistance*timing_capacitance*log1p(lower_resistance/feedback_resistance)"
      },
      {
        "key": "low_time",
        "label": "Output low interval",
        "unit": "s",
        "expression": "timing_resistance*timing_capacitance*log1p(upper_resistance/feedback_resistance)"
      },
      {
        "key": "frequency",
        "label": "Oscillation frequency",
        "unit": "Hz",
        "expression": "1/(high_time+low_time)"
      },
      {
        "key": "high_duty",
        "label": "Output high duty fraction",
        "unit": "1",
        "expression": "high_time/(high_time+low_time)"
      }
    ],
    "constraints": [],
    "example": {
      "inputs": {
        "supply_voltage": 5,
        "upper_resistance": 20000,
        "lower_resistance": 40000,
        "feedback_resistance": 20000,
        "timing_resistance": 10000,
        "timing_capacitance": 1e-07
      },
      "expected": {
        "upper_threshold": 4,
        "lower_threshold": 2,
        "high_time": 0.0010986122886681097,
        "low_time": 0.0006931471805599453,
        "frequency": 558.1106265512473,
        "high_duty": 0.6131471927654584
      },
      "relative_tolerance": 1e-09
    }
  }
]
