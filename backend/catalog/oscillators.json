[
  {
    "id": "oscillators.timer_555_astable",
    "title": "555 astable charge-discharge timing",
    "category": "Oscillator design",
    "level": "basic",
    "description": "Predict self-triggered 555 output timing from its separate charging and discharging paths.",
    "formula": "tH=ln(2)(RA+RB)C; tL=ln(2)RB C; T=tH+tL; f=1/T; D=tH/T",
    "assumptions": [
      "Standard astable: pins 2 and 6 share the timing capacitor; RA connects supply to pin 7; RB connects pin 7 to the capacitor.",
      "Ideal trigger/threshold levels are VCC/3 and 2VCC/3; discharge saturation, leakage, threshold errors and propagation delays are neglected.",
      "Use a properly decoupled 5–15 V bipolar 555 supply, reset high, and component/current ratings from the selected device. The bipolar-555 distortion guideline limits the nominal frequency to 100 kHz.",
      "Duty is the fraction of output-high time, not the discharge-transistor on-time. This topology cannot produce duty below 0.5 with positive RA."
    ],
    "references": [
      {
        "title": "Texas Instruments xx555 data sheet, SLFS022K, section 6.3.2, equations 1–4",
        "url": "https://www.ti.com/lit/ds/symlink/ne555.pdf"
      }
    ],
    "inputs": [
      {
        "key": "charge_resistance",
        "label": "Supply-to-discharge resistance RA",
        "unit": "ohm",
        "default": 1000,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "discharge_resistance",
        "label": "Discharge-to-capacitor resistance RB",
        "unit": "ohm",
        "default": 10000,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "timing_capacitance",
        "label": "Timing capacitance",
        "unit": "F",
        "default": 1e-07,
        "min": 0,
        "exclusive_min": true
      }
    ],
    "outputs": [
      {
        "key": "high_time",
        "label": "Output high interval",
        "unit": "s",
        "expression": "ln(2)*(charge_resistance+discharge_resistance)*timing_capacitance"
      },
      {
        "key": "low_time",
        "label": "Output low interval",
        "unit": "s",
        "expression": "ln(2)*discharge_resistance*timing_capacitance"
      },
      {
        "key": "period",
        "label": "Oscillation period",
        "unit": "s",
        "expression": "high_time+low_time"
      },
      {
        "key": "frequency",
        "label": "Oscillation frequency",
        "unit": "Hz",
        "expression": "1/period"
      },
      {
        "key": "high_duty",
        "label": "Output high duty fraction",
        "unit": "1",
        "expression": "(charge_resistance+discharge_resistance)/(charge_resistance+2*discharge_resistance)"
      }
    ],
    "constraints": [
      {
        "left": "ln(2)*(charge_resistance+2*discharge_resistance)*timing_capacitance",
        "op": ">=",
        "right": "1e-5",
        "message": "The bipolar 555 model requires nominal frequency no greater than 100 kHz."
      }
    ],
    "example": {
      "inputs": {
        "charge_resistance": 1000,
        "discharge_resistance": 10000,
        "timing_capacitance": 1e-07
      },
      "expected": {
        "high_time": 0.0007624618986159398,
        "low_time": 0.0006931471805599453,
        "period": 0.001455609079175885,
        "frequency": 686.997638518554,
        "high_duty": 0.5238095238095238
      },
      "relative_tolerance": 1e-09
    }
  },
  {
    "id": "oscillators.comparator_rc_oscillator",
    "title": "Three-resistor comparator RC oscillator",
    "category": "Oscillator design",
    "level": "intermediate",
    "description": "Design the unequal duty and switching thresholds of an autonomous comparator relaxation oscillator.",
    "formula": "G=1+RF/RU+RF/RL; VL=Vs(RF/RU)/G; VH=Vs(1+RF/RU)/G; tH=RT C ln(1+RL/RF); tL=RT C ln(1+RU/RF)",
    "assumptions": [
      "Comparator output switches ideally between ground and supply. RU joins supply to noninverting input, RL joins that input to ground, and RF joins output to that input.",
      "Output drives timing resistor RT; timing capacitor to ground drives the inverting input. Internal comparator hysteresis is neglected.",
      "Propagation delay and output resistance must be negligible compared with both half-cycle intervals and RT; input common-mode range must include both thresholds.",
      "Capacitor leakage, bias current, parasitic capacitance and output-loading effects are excluded. Values predict the settled cycle, not the first startup pulse."
    ],
    "references": [
      {
        "title": "Texas Instruments SNOA998A, Relaxation Oscillator Circuit, design steps 1–7",
        "url": "https://www.ti.com/lit/ab/snoa998a/snoa998a.pdf"
      }
    ],
    "inputs": [
      {
        "key": "supply_voltage",
        "label": "Ideal output-high and supply voltage",
        "unit": "V",
        "default": 5,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "upper_resistance",
        "label": "Threshold node to supply RU",
        "unit": "ohm",
        "default": 20000,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "lower_resistance",
        "label": "Threshold node to ground RL",
        "unit": "ohm",
        "default": 40000,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "feedback_resistance",
        "label": "Output to threshold node RF",
        "unit": "ohm",
        "default": 20000,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "timing_resistance",
        "label": "Output to capacitor RT",
        "unit": "ohm",
        "default": 10000,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "timing_capacitance",
        "label": "Timing capacitance",
        "unit": "F",
        "default": 1e-07,
        "min": 0,
        "exclusive_min": true
      }
    ],
    "outputs": [
      {
        "key": "upper_threshold",
        "label": "High-output switching threshold",
        "unit": "V",
        "expression": "supply_voltage*(1+feedback_resistance/upper_resistance)/(1+feedback_resistance/upper_resistance+feedback_resistance/lower_resistance)"
      },
      {
        "key": "lower_threshold",
        "label": "Low-output switching threshold",
        "unit": "V",
        "expression": "supply_voltage*(feedback_resistance/upper_resistance)/(1+feedback_resistance/upper_resistance+feedback_resistance/lower_resistance)"
      },
      {
        "key": "high_time",
        "label": "Output high interval",
        "unit": "s",
        "expression": "timing_resistance*timing_capacitance*log1p(lower_resistance/feedback_resistance)"
      },
      {
        "key": "low_time",
        "label": "Output low interval",
        "unit": "s",
        "expression": "timing_resistance*timing_capacitance*log1p(upper_resistance/feedback_resistance)"
      },
      {
        "key": "frequency",
        "label": "Oscillation frequency",
        "unit": "Hz",
        "expression": "1/(high_time+low_time)"
      },
      {
        "key": "high_duty",
        "label": "Output high duty fraction",
        "unit": "1",
        "expression": "high_time/(high_time+low_time)"
      }
    ],
    "constraints": [],
    "example": {
      "inputs": {
        "supply_voltage": 5,
        "upper_resistance": 20000,
        "lower_resistance": 40000,
        "feedback_resistance": 20000,
        "timing_resistance": 10000,
        "timing_capacitance": 1e-07
      },
      "expected": {
        "upper_threshold": 4,
        "lower_threshold": 2,
        "high_time": 0.0010986122886681097,
        "low_time": 0.0006931471805599453,
        "frequency": 558.1106265512473,
        "high_duty": 0.6131471927654584
      },
      "relative_tolerance": 1e-09
    }
  },
  {
    "id": "oscillators.triangle_integrator_oscillator",
    "title": "Integrator and comparator triangle oscillator",
    "category": "Oscillator design",
    "level": "intermediate",
    "description": "Calculate the triangle amplitude and self-oscillation period of a closed integrator–hysteresis loop.",
    "formula": "Vtri,pk=(RT/RF)Vsq,pk; |dVtri/dt|=Vsq,pk/(RI C); T=4 RI C RT/RF; f=1/T",
    "assumptions": [
      "All voltages are referred to a stiff midpoint or ground. Comparator output levels are symmetric at plus/minus square_peak.",
      "Comparator noninverting input sums triangle voltage through RT and comparator output through RF; its inverting input is grounded. An inverting integrator driven through RI closes the loop.",
      "The integrator uses feedback C and a grounded noninverting input. Available linear output swing must exceed the calculated triangle peak; slew rate must exceed ramp_slew.",
      "Comparator delay must be small compared with a half-cycle; integrator GBW, bias-current drift, capacitor leakage, offsets and saturation recovery are neglected. Output amplitude is not independently regulated."
    ],
    "references": [
      {
        "title": "Texas Instruments SBOA212B, PWM Generator Circuit, triangle-generator subcircuit and design steps 3–4",
        "url": "https://www.ti.com/lit/pdf/sboa212"
      }
    ],
    "inputs": [
      {
        "key": "square_peak",
        "label": "Comparator output peak about reference",
        "unit": "V",
        "default": 5,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "triangle_resistance",
        "label": "Triangle output to comparator sum RT",
        "unit": "ohm",
        "default": 8000,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "feedback_resistance",
        "label": "Comparator output to sum RF",
        "unit": "ohm",
        "default": 20000,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "integrator_resistance",
        "label": "Integrator input resistance RI",
        "unit": "ohm",
        "default": 10000,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "integrator_capacitance",
        "label": "Integrator feedback capacitance",
        "unit": "F",
        "default": 1e-08,
        "min": 0,
        "exclusive_min": true
      }
    ],
    "outputs": [
      {
        "key": "triangle_peak",
        "label": "Triangle peak about reference",
        "unit": "V",
        "expression": "square_peak*(triangle_resistance/feedback_resistance)"
      },
      {
        "key": "triangle_pp",
        "label": "Triangle peak-to-peak voltage",
        "unit": "V",
        "expression": "2*triangle_peak"
      },
      {
        "key": "ramp_slew",
        "label": "Magnitude of triangle ramp slope",
        "unit": "V/s",
        "expression": "square_peak/integrator_resistance/integrator_capacitance"
      },
      {
        "key": "period",
        "label": "Oscillation period",
        "unit": "s",
        "expression": "4*integrator_resistance*integrator_capacitance*(triangle_resistance/feedback_resistance)"
      },
      {
        "key": "frequency",
        "label": "Oscillation frequency",
        "unit": "Hz",
        "expression": "1/period"
      }
    ],
    "constraints": [],
    "example": {
      "inputs": {
        "square_peak": 5,
        "triangle_resistance": 8000,
        "feedback_resistance": 20000,
        "integrator_resistance": 10000,
        "integrator_capacitance": 1e-08
      },
      "expected": {
        "triangle_peak": 2,
        "triangle_pp": 4,
        "ramp_slew": 50000,
        "period": 0.00016,
        "frequency": 6250
      },
      "relative_tolerance": 1e-09
    }
  },
  {
    "id": "oscillators.wien_bridge_balance",
    "title": "Wien-bridge oscillator loop balance",
    "category": "Oscillator design",
    "level": "basic",
    "description": "Choose the frequency-selective bridge and test the amplifier gain needed for Wien-bridge oscillation.",
    "formula": "f0=1/(2 pi RC); beta=1/3; A=1+RF/RG; RF,critical=2 RG; loop_gain=A/3",
    "assumptions": [
      "Equal R and equal C in the series RC and parallel RC positive-feedback branches; ideal noninverting amplifier, dual supply and ground reference.",
      "Loop gain above one indicates small-signal growth; unity is marginal and does not guarantee startup. Below unity oscillations decay.",
      "A real steady sine requires amplitude stabilization or limiting; this calculation predicts neither amplitude nor distortion. RF is the small-signal feedback resistance.",
      "Op-amp closed-loop bandwidth must greatly exceed f0, slew rate must support the desired sine amplitude, and output loading and parasitics must be negligible."
    ],
    "references": [
      {
        "title": "Texas Instruments SLOA060, Sine-Wave Oscillator, sections 3, 6 and 8.1, equations 10–13",
        "url": "https://www.ti.com/lit/an/sloa060/sloa060.pdf"
      }
    ],
    "inputs": [
      {
        "key": "bridge_resistance",
        "label": "Each bridge resistance R",
        "unit": "ohm",
        "default": 10000,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "bridge_capacitance",
        "label": "Each bridge capacitance C",
        "unit": "F",
        "default": 1e-08,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "gain_resistance",
        "label": "Inverting input to ground RG",
        "unit": "ohm",
        "default": 10000,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "feedback_resistance",
        "label": "Output to inverting input RF",
        "unit": "ohm",
        "default": 20200,
        "min": 0,
        "exclusive_min": true
      }
    ],
    "outputs": [
      {
        "key": "frequency",
        "label": "Zero-phase bridge frequency",
        "unit": "Hz",
        "expression": "1/(2*pi)/bridge_resistance/bridge_capacitance"
      },
      {
        "key": "feedback_fraction",
        "label": "Bridge feedback fraction at zero phase",
        "unit": "1",
        "expression": "1/3"
      },
      {
        "key": "critical_feedback_resistance",
        "label": "Marginal RF for unity loop gain",
        "unit": "ohm",
        "expression": "2*gain_resistance"
      },
      {
        "key": "amplifier_gain",
        "label": "Noninverting amplifier gain",
        "unit": "1",
        "expression": "1+feedback_resistance/gain_resistance"
      },
      {
        "key": "loop_gain",
        "label": "Small-signal loop gain",
        "unit": "1",
        "expression": "amplifier_gain/3"
      },
      {
        "key": "loop_excess",
        "label": "Signed excess above unity loop gain",
        "unit": "1",
        "expression": "(feedback_resistance-2*gain_resistance)/gain_resistance/3"
      }
    ],
    "constraints": [],
    "example": {
      "inputs": {
        "bridge_resistance": 10000,
        "bridge_capacitance": 1e-08,
        "gain_resistance": 10000,
        "feedback_resistance": 20200
      },
      "expected": {
        "frequency": 1591.5494309189535,
        "feedback_fraction": 0.3333333333333333,
        "critical_feedback_resistance": 20000,
        "amplifier_gain": 3.02,
        "loop_gain": 1.0066666666666666,
        "loop_excess": 0.006666666666666667
      },
      "relative_tolerance": 1e-09
    }
  },
  {
    "id": "oscillators.loaded_rc_phase_shift",
    "title": "Loaded three-section RC oscillator",
    "category": "Oscillator design",
    "level": "intermediate",
    "description": "Size the gain and frequency of an unbuffered high-pass RC phase-shift oscillator including section loading.",
    "formula": "beta(s)=(sRC)^3/[(sRC)^3+6(sRC)^2+5sRC+1]; f0=1/(2 pi RC sqrt(6)); |beta(f0)|=1/29; |A|=RF/R",
    "assumptions": [
      "Three equal series capacitors form the feedback ladder. The first two nodes have R to ground; the final node connects through the third R to the op-amp virtual ground. No additional final-node shunt resistor is fitted.",
      "Amplifier noninverting input is grounded and RF feeds output to inverting input. This topology makes all three effective ladder loads equal to R.",
      "Mutual loading is included; independent buffered-section formulas (gain 8 and sqrt(3)/(2 pi RC)) do not apply.",
      "Ideal op-amp bandwidth and input impedance; no parasitics or output loading. Loop gain above one is a startup condition, not a prediction of steady amplitude, harmonic purity or startup time."
    ],
    "references": [
      {
        "title": "Georgia State University HyperPhysics, Phase-Shift Oscillator, 1/29 feedback and frequency equation",
        "url": "http://hyperphysics.phy-astr.gsu.edu/hbase/Electronic/oscphas.html"
      },
      {
        "title": "Texas Instruments SLOA060, section 8.2, warning about unbuffered RC section loading",
        "url": "https://www.ti.com/lit/an/sloa060/sloa060.pdf"
      }
    ],
    "inputs": [
      {
        "key": "section_resistance",
        "label": "Each effective ladder resistance R",
        "unit": "ohm",
        "default": 10000,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "section_capacitance",
        "label": "Each series ladder capacitance C",
        "unit": "F",
        "default": 1e-08,
        "min": 0,
        "exclusive_min": true
      },
      {
        "key": "feedback_resistance",
        "label": "Amplifier feedback resistance RF",
        "unit": "ohm",
        "default": 300000,
        "min": 0,
        "exclusive_min": true
      }
    ],
    "outputs": [
      {
        "key": "frequency",
        "label": "180-degree feedback frequency",
        "unit": "Hz",
        "expression": "1/(2*pi*sqrt(6))/section_resistance/section_capacitance"
      },
      {
        "key": "feedback_magnitude",
        "label": "Ladder feedback magnitude",
        "unit": "1",
        "expression": "1/29"
      },
      {
        "key": "critical_feedback_resistance",
        "label": "Marginal RF for unity loop gain",
        "unit": "ohm",
        "expression": "29*section_resistance"
      },
      {
        "key": "amplifier_gain_magnitude",
        "label": "Inverting gain magnitude",
        "unit": "1",
        "expression": "feedback_resistance/section_resistance"
      },
      {
        "key": "loop_gain",
        "label": "Small-signal loop gain",
        "unit": "1",
        "expression": "amplifier_gain_magnitude/29"
      },
      {
        "key": "loop_excess",
        "label": "Signed excess above unity loop gain",
        "unit": "1",
        "expression": "(feedback_resistance-29*section_resistance)/section_resistance/29"
      }
    ],
    "constraints": [],
    "example": {
      "inputs": {
        "section_resistance": 10000,
        "section_capacitance": 1e-08,
        "feedback_resistance": 300000
      },
      "expected": {
        "frequency": 649.7473343613968,
        "feedback_magnitude": 0.034482758620689655,
        "critical_feedback_resistance": 290000,
        "amplifier_gain_magnitude": 30,
        "loop_gain": 1.0344827586206897,
        "loop_excess": 0.034482758620689655
      },
      "relative_tolerance": 1e-09
    }
  }
]
